{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/psistla/fabric-ai-meta/master/schemas/workspace-summary/v1.json",
  "title": "Workspace Summary",
  "description": "Output schema for fabric-ai-meta scan command. Summarizes all models in a workspace with scores, counts, and recommendations.",
  "type": "object",
  "required": ["$schema", "version", "workspace", "scan_timestamp", "model_count", "average_readiness_score", "models", "score_ranking", "recommendations"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://raw.githubusercontent.com/psistla/fabric-ai-meta/master/schemas/workspace-summary/v1.json"
    },
    "version": {
      "type": "string"
    },
    "workspace": {
      "type": "string"
    },
    "scan_timestamp": {
      "type": "string"
    },
    "model_count": {
      "type": "integer",
      "minimum": 0
    },
    "average_readiness_score": {
      "type": ["number", "null"]
    },
    "models": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/model_summary"
      }
    },
    "score_ranking": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "copilot_summary": {
      "$ref": "#/$defs/copilot_summary"
    }
  },
  "$defs": {
    "model_summary": {
      "type": "object",
      "required": ["name", "slug", "ai_readiness_score", "table_count", "measure_count"],
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "ai_readiness_score": { "type": ["number", "null"] },
        "table_count": { "type": "integer" },
        "measure_count": { "type": "integer" },
        "description_coverage": { "type": ["number", "null"] },
        "extraction_timestamp": { "type": ["string", "null"] },
        "output_directory": { "type": "string" },
        "errors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "copilot": {
          "$ref": "#/$defs/copilot_signals"
        }
      },
      "additionalProperties": false
    },
    "copilot_signals": {
      "description": "Per-model governance signals derived from the Copilot/ folder. Same seven canonical signals as copilot_core_signals in the governance-report schema.",
      "allOf": [
        { "$ref": "#/$defs/copilot_core_signals" }
      ]
    },
    "copilot_core_signals": {
      "type": "object",
      "description": "Seven canonical Copilot signals shared with the governance-report schema. Sourced from CopilotBundle.signals().",
      "required": [
        "has_ai_instructions",
        "ai_instructions_length",
        "verified_answer_count",
        "ai_data_schema_table_count",
        "example_prompt_count",
        "copilot_enabled",
        "copilot_version"
      ],
      "properties": {
        "has_ai_instructions": { "type": "boolean" },
        "ai_instructions_length": { "type": "integer", "minimum": 0 },
        "verified_answer_count": { "type": "integer", "minimum": 0 },
        "ai_data_schema_table_count": { "type": "integer", "minimum": 0 },
        "example_prompt_count": { "type": "integer", "minimum": 0 },
        "copilot_enabled": { "type": ["boolean", "null"] },
        "copilot_version": { "type": ["string", "null"] }
      }
    },
    "copilot_summary": {
      "type": "object",
      "description": "Workspace-level rollup of per-model Copilot signals. Present when scan was run with --with-copilot.",
      "required": [
        "models_with_copilot",
        "models_with_copilot_names",
        "models_without_ai_instructions",
        "total_verified_answers"
      ],
      "properties": {
        "models_with_copilot": { "type": "integer", "minimum": 0 },
        "models_with_copilot_names": {
          "type": "array",
          "items": { "type": "string" }
        },
        "models_without_ai_instructions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "total_verified_answers": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
