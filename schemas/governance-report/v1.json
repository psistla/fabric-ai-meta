{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/psistla/fabric-ai-meta/master/schemas/governance-report/v1.json",
  "title": "Governance Report",
  "description": "Output schema for fabric-ai-meta governance command. Cross-model governance scorecard with naming inconsistencies, duplicate measures, and recommendations.",
  "type": "object",
  "required": ["$schema", "version", "workspace", "generated_at", "summary", "score_ranking", "naming_inconsistencies", "duplicate_measures", "recommendations"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://raw.githubusercontent.com/psistla/fabric-ai-meta/master/schemas/governance-report/v1.json"
    },
    "version": {
      "type": "string"
    },
    "workspace": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "score_ranking": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/score_ranking_item"
      }
    },
    "naming_inconsistencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/naming_inconsistency"
      }
    },
    "duplicate_measures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/duplicate_measure"
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "copilot_completeness": {
      "$ref": "#/$defs/copilot_completeness"
    }
  },
  "$defs": {
    "summary": {
      "type": "object",
      "required": ["model_count", "average_readiness_score", "total_naming_issues", "total_duplicate_measures"],
      "properties": {
        "model_count": { "type": "integer", "minimum": 0 },
        "average_readiness_score": { "type": ["number", "null"] },
        "lowest_scoring_model": {
          "oneOf": [
            {
              "type": "object",
              "required": ["name", "score"],
              "properties": {
                "name": { "type": "string" },
                "score": { "type": "number" }
              },
              "additionalProperties": false
            },
            { "type": "null" }
          ]
        },
        "highest_scoring_model": {
          "oneOf": [
            {
              "type": "object",
              "required": ["name", "score"],
              "properties": {
                "name": { "type": "string" },
                "score": { "type": "number" }
              },
              "additionalProperties": false
            },
            { "type": "null" }
          ]
        },
        "total_naming_issues": { "type": "integer", "minimum": 0 },
        "total_duplicate_measures": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "score_ranking_item": {
      "type": "object",
      "required": ["name", "ai_readiness_score", "table_count", "measure_count"],
      "properties": {
        "name": { "type": "string" },
        "ai_readiness_score": { "type": ["number", "null"] },
        "table_count": { "type": "integer" },
        "measure_count": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "naming_inconsistency": {
      "type": "object",
      "required": ["normalized", "variants", "found_in", "object_type"],
      "properties": {
        "normalized": { "type": "string" },
        "variants": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 2
        },
        "found_in": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "object_type": {
          "type": "string",
          "enum": ["column", "measure"]
        }
      },
      "additionalProperties": false
    },
    "duplicate_measure": {
      "type": "object",
      "required": ["dax_normalized", "found_in", "dax_identical"],
      "properties": {
        "dax_normalized": { "type": "string" },
        "found_in": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 2
        },
        "dax_identical": { "type": "boolean" },
        "measure_name": { "type": "string" },
        "variants": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "copilot_completeness": {
      "type": "object",
      "description": "Aggregate Copilot governance signals. Present only when at least one model carries a CopilotBundle.",
      "required": [
        "models_with_copilot",
        "models_with_copilot_names",
        "models_without_ai_instructions",
        "total_verified_answers",
        "per_model_signals"
      ],
      "properties": {
        "models_with_copilot": { "type": "integer", "minimum": 0 },
        "models_with_copilot_names": {
          "type": "array",
          "items": { "type": "string" }
        },
        "models_without_ai_instructions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "total_verified_answers": { "type": "integer", "minimum": 0 },
        "per_model_signals": {
          "type": "array",
          "items": { "$ref": "#/$defs/copilot_model_signals" }
        }
      },
      "additionalProperties": false
    },
    "copilot_core_signals": {
      "type": "object",
      "description": "Seven canonical Copilot signals shared with the workspace-summary schema.",
      "required": [
        "has_ai_instructions",
        "ai_instructions_length",
        "verified_answer_count",
        "ai_data_schema_table_count",
        "example_prompt_count",
        "copilot_enabled",
        "copilot_version"
      ],
      "properties": {
        "has_ai_instructions": { "type": "boolean" },
        "ai_instructions_length": { "type": "integer", "minimum": 0 },
        "verified_answer_count": { "type": "integer", "minimum": 0 },
        "ai_data_schema_table_count": { "type": "integer", "minimum": 0 },
        "example_prompt_count": { "type": "integer", "minimum": 0 },
        "copilot_enabled": { "type": ["boolean", "null"] },
        "copilot_version": { "type": ["string", "null"] }
      }
    },
    "copilot_model_signals": {
      "allOf": [
        { "$ref": "#/$defs/copilot_core_signals" },
        {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string" }
          }
        }
      ]
    }
  }
}
