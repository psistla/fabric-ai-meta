	measure 'Page 1 - Card - Livability HTML' = ```
			
			"<div style='font-family:system-ui,sans-serif;background:white;border-radius:10px;padding:12px 14px;position:relative;overflow:hidden;height:100%;cursor:pointer;'>" &
			
			  "" &
			  "<style>" &
			  "body { overflow: hidden !important; }" &
			    ".card-content { transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1); }" &
			    ".card-container:hover .card-content { transform: translateY(-100%); }" &
			    ".tooltip-overlay { " &
			        "position: absolute; top: 100%; left: 0; width: 100%; height: 100%; " &
			        "background: #0066CC; color: white; padding: 14px; " &
			        "transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1); " &
			        "display: flex; flex-direction: column; justify-content: center; box-sizing: border-box;" &
			    "}" &
			    ".card-container:hover .tooltip-overlay { transform: translateY(-100%); }" &
			  "</style>" &
			
			  "<div class='card-container' style='position:relative;width:100%;height:100%;overflow:hidden;'>" &
			    
			    "" &
			    "<div class='card-content' style='height:100%;'>" &
			      "<div style='margin-bottom:8px'>" &
			        "<svg width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='#0066CC' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>" &
			          "<path d='M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2'></path>" &
			          "<circle cx='9' cy='7' r='4'></circle>" &
			          "<path d='M23 21v-2a4 4 0 0 0-3-3.87'></path>" &
			          "<path d='M16 3.13a4 4 0 0 1 0 7.75'></path>" &
			        "</svg>" &
			      "</div>" &
			      
			      "<div style='font-size:25px;font-weight:700;color:#1a1a1a;line-height:1;margin-bottom:3px'>" &
			        FORMAT([Avg Livability Score], "0.0") &
			      "</div>" &
			      
			      "<div style='font-size:11px;font-weight:500;color:#666666;margin-bottom:10px'>" &
			        "Avg Livability Score" &
			      "</div>" &
			      
			      "<div style='padding-top:8px;border-top:1px solid #f0f0f0'>" &
			        "<div style='display:flex;justify-content:space-between;align-items:center;margin-bottom:6px'>" &
			          "<div style='font-size:9px;font-weight:600;color:#999999;text-transform:uppercase;'>All Cities Avg</div>" &
			          "<div style='font-size:13px;font-weight:600;color:#333333'>" & FORMAT([All Cities Avg Livability], "0.0") & "</div>" &
			        "</div>" &
			        "<div style='display:flex;justify-content:space-between;align-items:center'>" &
			          "<div style='font-size:9px;font-weight:600;color:#999999;text-transform:uppercase;'>Gap</div>" &
			          "<div style='font-size:13px;font-weight:700;" & IF([Gap Absolute] >= 0, "color:#0066CC", "color:#C75B5B") & "'>" & [Gap with Sign] & "</div>" &
			        "</div>" &
			      "</div>" &
			    "</div>" &
			
			    "" &
			    "<div class='tooltip-overlay'>" &
			      "<div style='font-size:12px;font-weight:700;margin-bottom:6px;border-bottom:1px solid rgba(255,255,255,0.3);padding-bottom:4px;'>Quick Guide</div>" &
			      "<p style='font-size:10px;line-height:1.4;margin:0;font-weight:400;'>" &
			        "This score represents the overall <strong>quality of life</strong>. It combines safety, healthcare, and culture." &
			      "</p>" &
			      "<div style='margin-top:10px;'>" &
			        "<div style='font-size:9px;opacity:0.9;'><strong>Benchmark:</strong> The typical score across all monitored cities.</div>" &
			        "<div style='font-size:9px;opacity:0.9;margin-top:4px;'><strong>Gap:</strong> How much this city is performing above or below that average.</div>" &
			      "</div>" &
			    "</div>" &
			
			  "</div>" &
			"</div>"
			```
		lineageTag: d6f8cd15-631c-4849-a716-d4a12197489f

	measure 'Page 1 - Card - Rank HTML' = ```
			
			"<div style='font-family:system-ui,sans-serif;background:white;border-radius:10px;padding:12px 14px;position:relative;overflow:hidden;height:100%;cursor:pointer;'>" &
			
			  "" &
			  "<style>" &
			  "body { overflow: hidden !important; }" &
			    ".card-content-rank { transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1); }" &
			    ".card-container-rank:hover .card-content-rank { transform: translateY(-100%); }" &
			    ".tooltip-overlay-rank { " &
			        "position: absolute; top: 100%; left: 0; width: 100%; height: 100%; " &
			        "background: #0066CC; color: white; padding: 14px; " &
			        "transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1); " &
			        "display: flex; flex-direction: column; justify-content: center; box-sizing: border-box;" &
			    "}" &
			    ".card-container-rank:hover .tooltip-overlay-rank { transform: translateY(-100%); }" &
			  "</style>" &
			
			  "<div class='card-container-rank' style='position:relative;width:100%;height:100%;overflow:hidden;'>" &
			    
			    "" &
			    "<div class='card-content-rank' style='height:100%;'>" &
			      "<div style='margin-bottom:8px'>" &
			        "<svg width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='#0066CC' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>" &
			          "<path d='M6 9H4.5a2.5 2.5 0 0 1 0-5H6'></path>" &
			          "<path d='M18 9h1.5a2.5 2.5 0 0 0 0-5H18'></path>" &
			          "<path d='M4 22h16'></path>" &
			          "<path d='M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22'></path>" &
			          "<path d='M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22'></path>" &
			          "<path d='M18 2H6v7a6 6 0 0 0 12 0V2Z'></path>" &
			        "</svg>" &
			      "</div>" &
			      
			      "<div style='font-size:25px;font-weight:700;color:#1a1a1a;line-height:1;margin-bottom:3px'>" &
			        [Rank Display] &
			      "</div>" &
			      
			      "<div style='font-size:11px;font-weight:500;color:#666666;margin-bottom:10px'>" &
			        "City Rank" &
			      "</div>" &
			      
			      "<div style='padding-top:8px;border-top:1px solid #f0f0f0'>" &
			        "<div style='display:flex;justify-content:space-between;align-items:center;margin-bottom:6px'>" &
			          "<div style='font-size:9px;font-weight:600;color:#999999;text-transform:uppercase;'>Rank Context</div>" &
			          "<div style='font-size:13px;font-weight:600;color:#333333'>" & [Rank Context] & "</div>" &
			        "</div>" &
			        "<div style='display:flex;justify-content:space-between;align-items:center'>" &
			          "<div style='font-size:9px;font-weight:600;color:#999999;text-transform:uppercase;'>Performance Tier</div>" &
			          "<div style='font-size:13px;font-weight:700;color:#0066CC'>" & [Performance Tier] & "</div>" &
			        "</div>" &
			      "</div>" &
			    "</div>" &
			
			    "" &
			    "<div class='tooltip-overlay-rank'>" &
			      "<div style='font-size:12px;font-weight:700;margin-bottom:6px;border-bottom:1px solid rgba(255,255,255,0.3);padding-bottom:4px;'>Rank Insights</div>" &
			      "<p style='font-size:10px;line-height:1.4;margin:0;font-weight:400;'>" &
			        "This shows where the city stands compared to all others. A lower number means <strong>better performance</strong>." &
			      "</p>" &
			      "<div style='margin-top:10px;'>" &
			        "<div style='font-size:9px;opacity:0.9;'><strong>Performance Tier:</strong> A classification from 'Elite' to 'Improving' based on percentile.</div>" &
			        "<div style='font-size:9px;opacity:0.9;margin-top:4px;'><strong>Context:</strong> Total number of cities being compared in this metric.</div>" &
			      "</div>" &
			    "</div>" &
			
			  "</div>" &
			"</div>"
			```
