	measure 'Page 4 - Green Space Peak Card' = ```
			
			VAR CurrentCity = SELECTEDVALUE('City Lookup'[City])
			
			VAR PeakYear = CALCULATE(MAXX(VALUES('City Metrics'[Year]), 'City Metrics'[Year]), TOPN(1, VALUES('City Metrics'[Year]), [Avg Green Space], DESC))
			VAR PeakValue = CALCULATE([Avg Green Space], 'City Metrics'[Year] = PeakYear)
			VAR LowYear = CALCULATE(MAXX(VALUES('City Metrics'[Year]), 'City Metrics'[Year]), TOPN(1, VALUES('City Metrics'[Year]), [Avg Green Space], ASC))
			VAR LowValue = CALCULATE([Avg Green Space], 'City Metrics'[Year] = LowYear)
			VAR Range = PeakValue - LowValue
