	measure 'Notifications Panel - Complete' = ```
			
			VAR CurrentYear = MAX('City Metrics'[Year])
			VAR PrevYear = CurrentYear - 1
			
			
			VAR EmissionsData = ADDCOLUMNS(ALL('City Lookup'[City]), "@Current", CALCULATE([Selected Metric], 'City Metrics'[Year] = CurrentYear, 'Parameter'[Parameter Order] = 4), "@Previous", CALCULATE([Selected Metric], 'City Metrics'[Year] = PrevYear, 'Parameter'[Parameter Order] = 4), "@Change", CALCULATE([Selected Metric], 'City Metrics'[Year] = CurrentYear, 'Parameter'[Parameter Order] = 4) - CALCULATE([Selected Metric], 'City Metrics'[Year] = PrevYear, 'Parameter'[Parameter Order] = 4))
			VAR Alert1 = TOPN(1, FILTER(EmissionsData, [@Change] > 0), [@Change], DESC)
			VAR Alert1City = MAXX(Alert1, 'City Lookup'[City])
			VAR Alert1Value = MAXX(Alert1, [@Change])
			VAR Alert1Current = MAXX(Alert1, [@Current])
			VAR HousingData = ADDCOLUMNS(ALL('City Lookup'[City]), "@Current", CALCULATE([Selected Metric], 'City Metrics'[Year] = CurrentYear, 'Parameter'[Parameter Order] = 1), "@Previous", CALCULATE([Selected Metric], 'City Metrics'[Year] = PrevYear, 'Parameter'[Parameter Order] = 1), "@Change", CALCULATE([Selected Metric], 'City Metrics'[Year] = CurrentYear, 'Parameter'[Parameter Order] = 1) - CALCULATE([Selected Metric], 'City Metrics'[Year] = PrevYear, 'Parameter'[Parameter Order] = 1))
			VAR Alert2 = TOPN(1, FILTER(HousingData, [@Change] < 0), [@Change], ASC)
			VAR Alert2City = MAXX(Alert2, 'City Lookup'[City])
			VAR Alert2Value = MAXX(Alert2, [@Change])
			VAR Alert2Current = MAXX(Alert2, [@Current])
			VAR LivabilityData = ADDCOLUMNS(ALL('City Lookup'[City]), "@Current", CALCULATE([Selected Metric], 'City Metrics'[Year] = CurrentYear, 'Parameter'[Parameter Order] = 0))
			VAR Alert3 = TOPN(1, LivabilityData, [@Current], DESC)
			VAR Alert3City = MAXX(Alert3, 'City Lookup'[City])
			VAR Alert3Current = MAXX(Alert3, [@Current])
			VAR TransitData = ADDCOLUMNS(ALL('City Lookup'[City]), "@Current", CALCULATE([Selected Metric], 'City Metrics'[Year] = CurrentYear, 'Parameter'[Parameter Order] = 2), "@Previous", CALCULATE([Selected Metric], 'City Metrics'[Year] = PrevYear, 'Parameter'[Parameter Order] = 2), "@Change", CALCULATE([Selected Metric], 'City Metrics'[Year] = CurrentYear, 'Parameter'[Parameter Order] = 2) - CALCULATE([Selected Metric], 'City Metrics'[Year] = PrevYear, 'Parameter'[Parameter Order] = 2))
			VAR InsightTop = TOPN(1, FILTER(TransitData, [@Change] > 0), [@Change], DESC)
			VAR InsightCity = MAXX(InsightTop, 'City Lookup'[City])
			VAR InsightValue = MAXX(InsightTop, [@Change])
			VAR HasAlert1 = NOT(ISBLANK(Alert1City))
			VAR HasAlert2 = NOT(ISBLANK(Alert2City))
			VAR HasAlert3 = NOT(ISBLANK(Alert3City))
			VAR TotalAlerts = IF(HasAlert1, 1, 0) + IF(HasAlert2, 1, 0) + IF(HasAlert3, 1, 0)
			
			RETURN
			IF(
			    TotalAlerts = 0,
			    "No notifications available",
			    
			"<style>" &
			  "body,html{overflow:hidden!important;margin:0;padding:0;height:100%}" &
			  "*{overflow:hidden!important;scrollbar-width:none!important;box-sizing:border-box}" &
			  "::-webkit-scrollbar{display:none!important;width:0!important;height:0!important}" &
			  "@keyframes slideInRight{from{transform:translateX(30px);opacity:0}to{transform:translateX(0);opacity:1}}" &
			  ".notification-card{animation:slideInRight 0.5s ease-out forwards;opacity:0}" &
			  ".notification-card:nth-child(1){animation-delay:0.1s}" &
			  ".notification-card:nth-child(2){animation-delay:0.3s}" &
			  ".notification-card:nth-child(3){animation-delay:0.5s}" &
			  ".notification-card:nth-child(4){animation-delay:0.7s}" &
			  ".notification-card:nth-child(5){animation-delay:0.9s}" &
			"</style>" &
			
			"<div style='font-family:system-ui,sans-serif;padding:0;background:linear-gradient(180deg, #0F1C2E 0%, #1A2942 50%, #0A1628 100%);height:720px;width:280px;display:flex;flex-direction:column;overflow:hidden!important;margin:0;box-shadow:inset 0 1px 0 rgba(255,255,255,0.05)'>" &
			
			  "" &
			  "<div style='padding:18px 20px 14px;border-bottom:1px solid rgba(255,255,255,0.1)'>" &
			    "<div style='font-size:19px;font-weight:700;color:#FFFFFF;margin-bottom:5px;letter-spacing:-0.03em'>Notifications</div>" &
			    "<div style='display:flex;align-items:center;gap:8px'>" &
			      "<div style='font-size:11px;color:rgba(255,255,255,0.65);font-weight:400'>Page insights for " & CurrentYear & "</div>" &
			      "<div style='display:inline-block;background:#FF6B6B;color:white;padding:2px 8px;border-radius:10px;font-size:10px;font-weight:600;box-shadow:0 2px 4px rgba(255,107,107,0.3)'>" & TotalAlerts & " alert" & IF(TotalAlerts > 1, "s", "") & "</div>" &
			    "</div>" &
			  "</div>" &
			
			  "" &
			  "<div style='padding:16px 20px;flex:1;overflow:hidden;display:flex;flex-direction:column;gap:10px'>" &
			    
			    
			    IF(HasAlert1, "<div class='notification-card' style='background:rgba(10,22,40,0.6);border-left:3px solid #FF6B6B;border-radius:8px;padding:12px;backdrop-filter:blur(10px);border:1px solid rgba(255,107,107,0.15)'><div style='display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:7px'><div style='display:flex;align-items:center;gap:6px'><svg width='13' height='13' viewBox='0 0 24 24' fill='none' stroke='#FF6B6B' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='10'/><line x1='12' y1='8' x2='12' y2='12'/><line x1='12' y1='16' x2='12.01' y2='16'/></svg><div style='font-size:9px;font-weight:600;color:#FF6B6B;text-transform:uppercase;letter-spacing:0.05em'>Critical</div></div><div style='font-size:8px;color:rgba(255,255,255,0.4)'>" & CurrentYear & "</div></div><div style='font-size:12px;font-weight:600;color:#FFFFFF;margin-bottom:5px'>" & Alert1City & " Emissions Alert</div><div style='font-size:10px;color:rgba(255,255,255,0.65);line-height:1.4'>Emissions rose by <span style='font-weight:600;color:#FF6B6B'>+" & FORMAT(Alert1Value, "0.0") & " pts</span> to " & FORMAT(Alert1Current, "0.0") & " pts.</div></div>", "") &
			    IF(HasAlert2, "<div class='notification-card' style='background:rgba(10,22,40,0.6);border-left:3px solid #FFB74D;border-radius:8px;padding:12px;backdrop-filter:blur(10px);border:1px solid rgba(255,183,77,0.15)'><div style='display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:7px'><div style='display:flex;align-items:center;gap:6px'><svg width='13' height='13' viewBox='0 0 24 24' fill='none' stroke='#FFB74D' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z'/><line x1='12' y1='9' x2='12' y2='13'/><line x1='12' y1='17' x2='12.01' y2='17'/></svg><div style='font-size:9px;font-weight:600;color:#FFB74D;text-transform:uppercase;letter-spacing:0.05em'>Warning</div></div><div style='font-size:8px;color:rgba(255,255,255,0.4)'>" & CurrentYear & "</div></div><div style='font-size:12px;font-weight:600;color:#FFFFFF;margin-bottom:5px'>" & Alert2City & " Housing Crisis</div><div style='font-size:10px;color:rgba(255,255,255,0.65);line-height:1.4'>Affordability dropped <span style='font-weight:600;color:#FFB74D'>" & FORMAT(Alert2Value, "0.0") & " pts</span>.</div></div>", "") &
			    IF(HasAlert3, "<div class='notification-card' style='background:rgba(10,22,40,0.6);border-left:3px solid #66B2FF;border-radius:8px;padding:12px;backdrop-filter:blur(10px);border:1px solid rgba(102,178,255,0.15)'><div style='display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:7px'><div style='display:flex;align-items:center;gap:6px'><svg width='13' height='13' viewBox='0 0 24 24' fill='none' stroke='#66B2FF' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M22 11.08V12a10 10 0 1 1-5.93-9.14'/><polyline points='22 4 12 14.01 9 11.01'/></svg><div style='font-size:9px;font-weight:600;color:#66B2FF;text-transform:uppercase;letter-spacing:0.05em'>Top Performer</div></div><div style='font-size:8px;color:rgba(255,255,255,0.4)'>" & CurrentYear & "</div></div><div style='font-size:12px;font-weight:600;color:#FFFFFF;margin-bottom:5px'>" & Alert3City & " Leads Overall</div><div style='font-size:10px;color:rgba(255,255,255,0.65);line-height:1.4'>Top Livability with <span style='font-weight:600;color:#66B2FF'>" & FORMAT(Alert3Current, "0.0") & " pts</span>.</div></div>", "") &
			
			    "" &
			    "<div class='notification-card' style='background:rgba(255,255,255,0.95);border-left:3px solid #0066CC;border-radius:8px;padding:12px;border:1px solid rgba(255,255,255,0.2);margin-top:auto'>" &
			      "<div style='display:flex;align-items:center;gap:6px;margin-bottom:7px'>" &
			        "<svg width='13' height='13' viewBox='0 0 24 24' fill='none' stroke='#0066CC' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='10'/><path d='M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3'/><line x1='12' y1='17' x2='12.01' y2='17'/></svg>" &
			        "<div style='font-size:9px;font-weight:600;color:#0066CC;text-transform:uppercase;letter-spacing:0.05em'>Quick Tips</div>" &
			      "</div>" &
			      "<div style='font-size:12px;font-weight:600;color:#0A1628;margin-bottom:5px'>Need help exploring?</div>" &
			      "<div style='font-size:10px;color:#3A4A5A;line-height:1.4'>" &
			        "Try our <span style='font-weight:600;color:#0066CC'>intuitive tutorial</span> to master the data. " &
			        "Use the <span style='font-weight:600'>Filter icon</span> in the top menu to select a specific city or analysis year." &
			      "</div>" &
			    "</div>" &
			    
			  "</div>" &
			"</div>"
			)
			```
