			        "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#4A9B9B' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>" &
			          "<path d='M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z'></path>" &
			          "<path d='M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12'></path>" &
			        "</svg>" &
			        "<div style='font-size:10px;font-weight:600;color:#8BA3B8;text-transform:uppercase;'>Emissions</div>" &
			      "</div>" &
			      "<div style='margin-bottom:6px;'>" &
			        "<div style='font-size:8px;color:#7D92A8;'>⭐ Best (Low)</div>" &
			        "<div style='font-size:18px;font-weight:700;color:#FFFFFF;line-height:1;'>" & PeakYear & ": " & FORMAT(PeakValue, "0.0") & "</div>" &
			      "</div>" &
			      "<div style='margin-bottom:6px;'>" &
			        "<div style='font-size:8px;color:#7D92A8;'>▼ Worst (High)</div>" &
			        "<div style='font-size:13px;font-weight:600;color:#C5D3E0;line-height:1;'>" & LowYear & ": " & FORMAT(LowValue, "0.0") & "</div>" &
			      "</div>" &
			      "<div style='display:flex;justify-content:space-between;padding:6px 0;border-top:1px solid rgba(255,255,255,0.1);border-bottom:1px solid rgba(255,255,255,0.1);margin-bottom:8px;'>" &
			        "<div style='font-size:8px;font-weight:600;color:#7D92A8;text-transform:uppercase;'>RANGE</div>" &
			        "<div style='font-size:13px;font-weight:700;color:#FFFFFF;'>" & FORMAT(Range, "0.0") & "</div>" &
			      "</div>" &
			      "<div style='background:rgba(74,155,155,0.12);border-radius:4px;padding:8px;border-left:2px solid #4A9B9B;'>" &
			        "<div style='font-size:7px;font-weight:600;color:#4A9B9B;margin-bottom:3px;text-transform:uppercase;letter-spacing:0.5px;'>Action</div>" &
			        "<div style='font-size:8px;line-height:1.35;color:#B8C9D9;'>" & ActionPlan & "</div>" &
			      "</div>" &
			    "</div>" &
			
			    "<div class='tooltip-overlay-p4-emi'>" &
			      "<div style='font-size:10px;font-weight:700;margin-bottom:6px;border-bottom:1px solid rgba(255,255,255,0.3);padding-bottom:4px;'>10-Year Analysis</div>" &
			      "<p style='font-size:8px;line-height:1.4;margin:0;font-weight:400;'>" &
			        "Lowest emissions in <strong>" & PeakYear & "</strong> at <strong>" & FORMAT(PeakValue, "0.0") & " pts</strong>. " &
			        "The <strong>" & FORMAT(Range, "0.0") & " pt reduction</strong> shows " &
			        IF(Range > 10, "strong", "moderate") & " climate progress." &
			      "</p>" &
			      "<div style='margin-top:8px;font-size:8px;opacity:0.9;'>" &
			        "<strong>Trend:</strong> " & IF(IsImproving, "Meeting climate goals", "Emissions rising") &
			      "</div>" &
			    "</div>" &
			
			  "</div>" &
			"</div>"
			
			RETURN IF(NOT(ISBLANK(CurrentCity)), HTMLCard, BLANK())
