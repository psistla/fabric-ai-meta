	/// Dynamic title for bar chart showing city comparison insights
	measure 'Page 1 - Bar Chart - Title' = ```
			
			VAR MetricOrder = SELECTEDVALUE('Parameter'[Parameter Order])
			VAR MetricName = 
			    SWITCH(
			        MetricOrder,
			        0, "Livability Index",
			        1, "Housing Affordability",
			        2, "Transit Quality",
			        3, "Green Space",
			        4, "Emissions",
			        "Selected Metric"
			    )
			VAR CurrentYear = MAX('City Metrics'[Year])
			
			
			VAR TopCityTable = 
			    ADDCOLUMNS(
			        ALL('City Lookup'[City]),
			        "@Value", CALCULATE([Selected Metric], 'City Metrics'[Year] = CurrentYear)
			    )
			VAR TopCity = TOPN(1, TopCityTable, [@Value], DESC)
			VAR TopCityName = MAXX(TopCity, 'City Lookup'[City])
			VAR TopValue = MAXX(TopCity, [@Value])
			
			
			VAR BottomCity = TOPN(1, TopCityTable, [@Value], ASC)
			VAR BottomCityName = MAXX(BottomCity, 'City Lookup'[City])
			VAR BottomValue = MAXX(BottomCity, [@Value])
			
			
			VAR CityGap = TopValue - BottomValue
			VAR GapPct = DIVIDE(CityGap, BottomValue, 0)
			
			VAR TitleText = 
			    TopCityName & " leads in " & MetricName & 
			    " (" & FORMAT(TopValue, "0.0") & " pts) ⁕ " &
			    FORMAT(GapPct, "0.0%") & " ahead of " & BottomCityName
			
			RETURN
			TitleText
			
			```
		lineageTag: 9d29700d-8422-4014-b474-3bf8a1e51551

	/// Dynamic subtitle for bar chart with distribution and benchmark insights
	measure 'Page 1 - Bar Chart - Subtitle' = ```
			
			VAR CurrentYear = MAX('City Metrics'[Year])
			VAR BenchmarkValue = 
			    CALCULATE(
			        [All Cities Benchmark],
			        'City Metrics'[Year] = CurrentYear
			    )
			
			VAR CitiesAbove = 
			    COUNTROWS(
			        FILTER(
			            ALL('City Lookup'[City]),
			            CALCULATE([Selected Metric], 'City Metrics'[Year] = CurrentYear) > BenchmarkValue
			        )
			    )
			VAR CitiesBelow = 
			    COUNTROWS(
			        FILTER(
			            ALL('City Lookup'[City]),
			            CALCULATE([Selected Metric], 'City Metrics'[Year] = CurrentYear) < BenchmarkValue
			        )
			    )
			
			VAR PrevYear = CurrentYear - 1
			VAR CitiesWithGrowth = 
			    ADDCOLUMNS(
			        ALL('City Lookup'[City]),
			        "@CurrentValue", CALCULATE([Selected Metric], 'City Metrics'[Year] = CurrentYear),
			        "@PrevValue", CALCULATE([Selected Metric], 'City Metrics'[Year] = PrevYear),
			        "@Growth", 
			            CALCULATE([Selected Metric], 'City Metrics'[Year] = CurrentYear) - 
			            CALCULATE([Selected Metric], 'City Metrics'[Year] = PrevYear)
			    )
			VAR TopGrower = TOPN(1, CitiesWithGrowth, [@Growth], DESC)
			VAR TopGrowerName = MAXX(TopGrower, 'City Lookup'[City])
			VAR TopGrowth = MAXX(TopGrower, [@Growth])
			
			
			VAR DistributionText = 
			    CitiesAbove & " cities above average (" & FORMAT(BenchmarkValue, "0.0") & "), " &
			    CitiesBelow & " below"
			
			
			VAR GrowthText = 
			    IF(
			        NOT(ISBLANK(TopGrowth)) && TopGrowth > 0,
			        " • Best YoY: " & TopGrowerName & " (" & FORMAT(TopGrowth, "+0.0") & " pts)",
			        ""
			    )
			
			VAR SubtitleText = 
			    DistributionText & GrowthText & " • Year: " & CurrentYear
			
			RETURN
			SubtitleText
			
			```
		lineageTag: c711808d-bb34-4bcc-98f8-5edfe89346d6

	/// YoY change with arrow indicator for ranking table
	measure 'Page 1 - Ranking YoY Display' = ```
			VAR CurrentYear = MAX('City Metrics'[Year])
			VAR PrevYear = CurrentYear - 1
			VAR CurrentValue = CALCULATE([Selected Metric], 'City Metrics'[Year] = CurrentYear)
			VAR PrevValue = CALCULATE([Selected Metric], 'City Metrics'[Year] = PrevYear)
			VAR Change = CurrentValue - PrevValue
			
			
			VAR AllCitiesYoY = 
			    ADDCOLUMNS(
			        ALL('City Lookup'[City]),
			        "@YoYChange", 
			            VAR Curr = CALCULATE([Selected Metric], 'City Metrics'[Year] = CurrentYear)
			            VAR Prev = CALCULATE([Selected Metric], 'City Metrics'[Year] = PrevYear)
			            RETURN Curr - Prev
			    )
			
			VAR Top3Positive = TOPN(3, AllCitiesYoY, [@YoYChange], DESC)
			VAR Top3Negative = TOPN(3, AllCitiesYoY, [@YoYChange], ASC)
			VAR CurrentCity = SELECTEDVALUE('City Lookup'[City])
			
			VAR IsTop3Positive = COUNTROWS(FILTER(Top3Positive, 'City Lookup'[City] = CurrentCity)) > 0
			VAR IsTop3Negative = COUNTROWS(FILTER(Top3Negative, 'City Lookup'[City] = CurrentCity)) > 0
			
			
			VAR _BgColor = 
			    IF(IsTop3Positive, "#E3F2FD",     
			    IF(IsTop3Negative, "#FFEBEE",     
			    "transparent"))                   
			
			VAR _TextColor = 
			    IF(IsTop3Positive, "#1565C0",     
			    IF(IsTop3Negative, "#C62828",     
			    "#252423"))                       
			
			VAR FormattedValue = FORMAT(Change, "+0.0;-0.0")
			
			
			VAR SVGOutput = 
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='240' height='75'>
			    <rect x='0' y='0' width='240' height='75' rx='38' fill='" & _BgColor & "'/>
			    <text x='120' y='50' text-anchor='middle' font-family='system-ui,-apple-system,Segoe UI,sans-serif' font-size='40' font-weight='600' letter-spacing='-0.02em' fill='" & _TextColor & "'>" & FormattedValue & "</text>
			    </svg>"
			
			RETURN SVGOutput
			```
		lineageTag: 33203902-3e72-4cd2-8362-e2674fb9c8b5
		dataCategory: ImageUrl

