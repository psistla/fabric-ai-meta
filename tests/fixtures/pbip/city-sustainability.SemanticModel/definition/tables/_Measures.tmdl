	/// Combined score from all 5 city metrics normalized to 0-100% scale
	measure 'General Performance Score' = ```
			
			
			VAR HousingScore = [_Norm Housing Score]
			VAR TransitScore = [_Norm Transit Score]
			VAR GreenScore = [_Norm Green Space Score]
			VAR EmissionsScore = [_Norm Emissions Score]
			VAR LivabilityScore = [_Norm Livability Score]
			
			VAR GeneralScore = 
			    DIVIDE(
			        HousingScore + TransitScore + GreenScore + EmissionsScore + LivabilityScore,
			        5,
			        BLANK()
			    )
			
			RETURN GeneralScore / 100
			```
		formatString: 0.0"%"
		lineageTag: 8ffb9141-7b5f-41e2-9934-cc5faff5c4e6

	measure 'Page 2 - Header - Title and Context' = ```
			
			VAR SelectedCity = SELECTEDVALUE('City Lookup'[City], "All Cities")
			VAR SelectedYear = SELECTEDVALUE('City Metrics'[Year], YEAR(TODAY()))
			
			RETURN
			"<div style='
			    font-family: Segoe UI, sans-serif;
			    padding: 0px;
			    line-height: 1;
			'>
			    <div style='
			        font-size: 22px;
			        font-weight: 600;
			        color: #0A1628;
			        margin-bottom: 8px;
			    '>City Performance</div>
			    <div style='
			        font-size: 12px;
			        color: #64748B;
			        font-weight: 400;
			    '>
			        <span style='color: #64748B;'>City:</span> 
			        <span style='font-weight: 600; color: #0A1628;'>" & SelectedCity & "</span>
			        <span style='margin: 0 8px; color: #CBD5E1;'>•</span>
			        <span style='color: #64748B;'>Year:</span> 
			        <span style='font-weight: 600; color: #0A1628;'>" & SelectedYear & "</span>
			    </div>
			</div>"
			
			```
		lineageTag: a4aa85bd-c70f-4798-b6e8-5872df262740

	measure 'Page 2 - Insight - Performance Analysis' = ```
			
			VAR SelectedCityName = SELECTEDVALUE('City Lookup'[City], "No City")
			VAR CurrentYear = MAX('City Metrics'[Year])
			
			
			VAR LivabilityScore = [Avg Livability Score]
			VAR HousingScore = [Avg Housing Affordability]
			VAR TransitScore = [Avg Transit Score]
			VAR GreenScore = [Avg Green Space]
			VAR EmissionsScore = [Avg Emissions]
			
			
			VAR MaxScore = MAX(LivabilityScore, MAX(HousingScore, MAX(TransitScore, MAX(GreenScore, EmissionsScore))))
			VAR StrongestDimension = 
			    SWITCH(
			        TRUE(),
			        MaxScore = LivabilityScore, "livability",
			        MaxScore = HousingScore, "housing affordability",
			        MaxScore = TransitScore, "transit infrastructure",
			        MaxScore = GreenScore, "green space coverage",
			        MaxScore = EmissionsScore, "emissions control",
			        "performance"
			    )
			
			
			VAR MinScore = MIN(LivabilityScore, MIN(HousingScore, MIN(TransitScore, MIN(GreenScore, EmissionsScore))))
			VAR WeakestDimension = 
			    SWITCH(
			        TRUE(),
			        MinScore = LivabilityScore, "livability",
			        MinScore = HousingScore, "housing affordability",
			        MinScore = TransitScore, "transit quality",
			        MinScore = GreenScore, "green space availability",
			        MinScore = EmissionsScore, "emissions management",
			        "dimension"
			    )
			
			
			VAR AvgScore = (LivabilityScore + HousingScore + TransitScore + GreenScore + EmissionsScore) / 5
			VAR Variancee = 
			    (POWER(LivabilityScore - AvgScore, 2) + 
			     POWER(HousingScore - AvgScore, 2) + 
			     POWER(TransitScore - AvgScore, 2) + 
			     POWER(GreenScore - AvgScore, 2) + 
			     POWER(EmissionsScore - AvgScore, 2)) / 5
			VAR IsBalanced = Variancee < 200
			
			
			VAR OverallCategory = 
			    SWITCH(
			        TRUE(),
			        AvgScore >= 70, "strong",
			        AvgScore >= 50, "moderate",
			        "developing"
			    )
			
			
			VAR DimensionsAboveAvg = 
			    IF(LivabilityScore > AvgScore, 1, 0) +
			    IF(HousingScore > AvgScore, 1, 0) +
			    IF(TransitScore > AvgScore, 1, 0) +
			    IF(GreenScore > AvgScore, 1, 0) +
			    IF(EmissionsScore > AvgScore, 1, 0)
			
			RETURN
			"<div style='font-family:Segoe UI,system-ui,sans-serif;padding:10px 14px;background:transparent;border-left:3px solid #0066CC;border-radius:6px;line-height:1.45;overflow:hidden;height:auto;max-height:100%;box-sizing:border-box'>" &
			 
			  "<div style='font-size:16px;font-weight:600;color:#0A1628;margin-bottom:6px'>" &
			    SelectedCityName & " demonstrates " & OverallCategory & " urban performance " &
			  "</div>" &
			 
			  "<div style='font-size:13px;color:#475569;font-weight:400;line-height:1.5'>" &
			    "Excels in <span style='font-weight:600;color:#0066CC'>" & StrongestDimension & "</span> (" & FORMAT(MaxScore, "0.0") & "%), " &
			    "while <span style='font-weight:600;color:#0066CC'>" & WeakestDimension & "</span> (" & FORMAT(MinScore, "0.0") & "%) " &
			    "presents the key development opportunity. " &
			    
			    IF(
			        IsBalanced,
			        "Performance is <span style='font-weight:600;color:#059669'>well-balanced</span> across metrics.",
			        "<span style='font-weight:600;color:#DC2626'>Variance</span> suggests focused intervention potential."
			    ) &
			    
			    " <span style='font-weight:600'>" & DimensionsAboveAvg & "/5 dimensions</span> exceed baseline." &
			  "</div>" &
			 
			
			"</div>"
			```
		lineageTag: fc9247c6-ba78-4861-afc2-88e2b0ccf52d

	measure 'Page 2 - Card - Overall Baseline HTML' =
			
			VAR CurrentCity = SELECTEDVALUE('City Lookup'[City], "Global")
			VAR SelectedYear = SELECTEDVALUE('City Metrics'[Year])
			VAR HasYearFilter = NOT(ISBLANK(SelectedYear))
			
			VAR LivabilityScore = [Avg Livability Score]
			VAR HousingScore = [Avg Housing Affordability]
			VAR TransitScore = [Avg Transit Score]
			VAR GreenScore = [Avg Green Space]
			VAR EmissionsScore = [Avg Emissions]
			VAR BaselineScore = (LivabilityScore + HousingScore + TransitScore + GreenScore + EmissionsScore) / 5
			
			VAR XMinYear = 2015
			VAR XMaxYear = 2024
			VAR SparklineTable =
			ADDCOLUMNS(
			CALCULATETABLE(
			FILTER(
			ALL('City Metrics'[Year]),
			'City Metrics'[Year] >= 2015 && 'City Metrics'[Year] <= 2024
			)
			),
			"@Year", 'City Metrics'[Year],
			"@Value",
			VAR YearLiv = CALCULATE([Avg Livability Score], 'City Lookup'[City] = CurrentCity)
			VAR YearHous = CALCULATE([Avg Housing Affordability], 'City Lookup'[City] = CurrentCity)
			VAR YearTrans = CALCULATE([Avg Transit Score], 'City Lookup'[City] = CurrentCity)
			VAR YearGreen = CALCULATE([Avg Green Space], 'City Lookup'[City] = CurrentCity)
			VAR YearEmis = CALCULATE([Avg Emissions], 'City Lookup'[City] = CurrentCity)
			RETURN (YearLiv + YearHous + YearTrans + YearGreen + YearEmis) / 5,
			"@X", 5 + INT(74 * DIVIDE('City Metrics'[Year] - XMinYear, XMaxYear - XMinYear))
			)
			VAR YMinValue = MINX(SparklineTable, [@Value])
			VAR YMaxValue = MAXX(SparklineTable, [@Value])
			VAR YRange = YMaxValue - YMinValue
			VAR SafeRange = IF(YRange = 0, 1, YRange)
			VAR SparklineTableWithY =
			ADDCOLUMNS(
			SparklineTable,
			"@Y", 4 + INT(16 * DIVIDE([@Value] - YMinValue, SafeRange))
			)
			VAR Points =
			CONCATENATEX(
			SparklineTableWithY,
			[@X] & "," & (24 - [@Y]),
			" ",
			[@Year],
			ASC
			)
			
			VAR LastX =
			MAXX(
			    SparklineTableWithY,
			    [@X]
			)
			
			VAR MidYear = 2020
			VAR MidX =
			    5 + INT(
			        74 * DIVIDE(MidYear - XMinYear, XMaxYear - XMinYear)
			    )
			
			
			VAR ValCurrent = BaselineScore
			VAR ValPrev =
			IF(
			HasYearFilter,
			VAR PrevLiv = CALCULATE([Avg Livability Score], 'City Lookup'[City] = CurrentCity, 'City Metrics'[Year] = SelectedYear - 1)
			VAR PrevHous = CALCULATE([Avg Housing Affordability], 'City Lookup'[City] = CurrentCity, 'City Metrics'[Year] = SelectedYear - 1)
			VAR PrevTrans = CALCULATE([Avg Transit Score], 'City Lookup'[City] = CurrentCity, 'City Metrics'[Year] = SelectedYear - 1)
			VAR PrevGreen = CALCULATE([Avg Green Space], 'City Lookup'[City] = CurrentCity, 'City Metrics'[Year] = SelectedYear - 1)
			VAR PrevEmis = CALCULATE([Avg Emissions], 'City Lookup'[City] = CurrentCity, 'City Metrics'[Year] = SelectedYear - 1)
			RETURN (PrevLiv + PrevHous + PrevTrans + PrevGreen + PrevEmis) / 5,
			BLANK()
			)
			VAR Diff = ValCurrent - ValPrev
			VAR BulletColor = IF(Diff >= 0, "#0066CC", "#C75B5B")
			VAR SelectedX = IF(HasYearFilter, 5 + INT(74 * DIVIDE(SelectedYear - XMinYear, XMaxYear - XMinYear)), BLANK())
			VAR SelectedY = IF(HasYearFilter, 24 - (4 + INT(16 * DIVIDE(ValCurrent - YMinValue, SafeRange))), BLANK())
			VAR DotMarker =
			IF(
			HasYearFilter,
			"<circle cx='" & SelectedX & "' cy='" & SelectedY & "' r='2.8' fill='" & BulletColor & "' stroke='white' stroke-width='1.5'>" &
			"<animate attributeName='opacity' from='0' to='1' dur='0.5s' begin='1s' fill='freeze' />" &
			"</circle>",
			""
			)
			VAR GradID = "gradBase" & SUBSTITUTE(SUBSTITUTE(CurrentCity, " ", ""), "-", "")
			VAR SVG_Raw =
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 84 28'>" &
			"<defs>" &
			"<linearGradient id='" & GradID & "' x1='0' y1='0' x2='0' y2='24' gradientUnits='userSpaceOnUse'>" &
			"<stop stop-color='#0066CC' offset='0' />" &
			"<stop stop-color='transparent' offset='1' />" &
			"</linearGradient>" &
			"</defs>" &
			
			
			"<polyline fill='url(#" & GradID & ")' fill-opacity='0.18' " &
			"stroke='none' " &
			"points='0 24 " & Points & " " & LastX & " 24'>" &
			"<animate attributeName='fill-opacity' from='0' to='0.18' dur='0.5s' begin='1s' fill='freeze' />" &
			"</polyline>" &
			
			
			"<polyline fill='none' " &
			"stroke='#B8B8B8' stroke-width='0.9' stroke-linecap='round' stroke-linejoin='round' " &
			"points='" & Points & "' " &
			"stroke-dasharray='500' stroke-dashoffset='500'>" &
			"<animate attributeName='stroke-dashoffset' from='500' to='0' dur='1.2s' begin='0s' fill='freeze' />" &
			"</polyline>" &
			
			
			/* X AXIS LABELS */
			"<text x='5' y='28' font-family='Segoe UI, system-ui, sans-serif' font-size='4' fill='#9E9E9E' text-anchor='start'>2015</text>" &
			"<text x='" & MidX & "' y='28' font-family='Segoe UI, system-ui, sans-serif' font-size='4' fill='#B0B0B0' text-anchor='middle'>2020</text>" &
			"<text x='" & LastX & "' y='28' font-family='Segoe UI, system-ui, sans-serif' font-size='4' fill='#9E9E9E' text-anchor='end'>2024</text>"
			
			
			
			&
			
			DotMarker &
			"</svg>"
			
			VAR SVGSparkline = "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(SVG_Raw, "#", "%23"), "'", """")
			RETURN
			"<div style='font-family:system-ui,sans-serif;background:white;border-radius:10px;padding:12px 14px;position:relative;overflow:hidden;height:100%;cursor:pointer;'>" &
			"<style>" &
			".card-content-baseline { transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1); }" &
			".card-container-baseline:hover .card-content-baseline { transform: translateY(-100%); }" &
			".tooltip-overlay-baseline { " &
			"position: absolute; top: 100%; left: 0; width: 100%; height: 100%; " &
			"background: #0066CC; color: white; padding: 14px; " &
			"transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1); " &
			"display: flex; flex-direction: column; justify-content: center; box-sizing: border-box;" &
			"}" &
			".card-container-baseline:hover .tooltip-overlay-baseline { transform: translateY(-100%); }" &
			"</style>" &
			"<div class='card-container-baseline' style='position:relative;width:100%;height:100%;overflow:hidden;'>" &
			"<div class='card-content-baseline' style='height:100%;display:flex;flex-direction:column;'>" &
			"<div style='margin-bottom:6px'>" &
			"<svg width='20' height='20' viewBox='0 0 24 24' fill='none' stroke='#999999' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>" &
			"<polygon points='12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2'></polygon>" &
			"</svg>" &
			"</div>" &
			"<div style='font-size:25px;font-weight:700;color:#1a1a1a;line-height:1.1;margin-bottom:2px'>" &
			FORMAT(BaselineScore, "0.0") &
			"</div>" &
			"<div style='font-size:11px;font-weight:500;color:#666666;margin-bottom:8px'>" &
			"Overall Baseline" &
			"</div>" &
			"<div style='border-top:1px solid #f0f0f0; margin-bottom:10px;'>" &
			    "<img src='" & SVGSparkline & "' style='width:100%;height:auto;display:block;' />" &
			  "</div>" &
			"</div>" &
			
			"<div class='tooltip-overlay-baseline'>" &
			  "<div style='font-size:12px;font-weight:700;margin-bottom:6px;border-bottom:1px solid rgba(255,255,255,0.3);padding-bottom:4px;'>Quick Guide</div>" &
			  "<p style='font-size:10px;line-height:1.4;margin:0;font-weight:400;'>" &
			    "This is the <strong>average score across all 5 dimensions</strong>. It represents the city's overall urban performance baseline. <strong>Higher values indicate comprehensive urban development</strong>." &
			  "</p>" &
			"</div>" &
			"</div>" &
			"</div>"
		lineageTag: f054489b-56c0-4604-bd86-ce3e42c854e5

	measure 'Alt Text - Page 2 Radar Chart' = ```
			
			VAR CityName = SELECTEDVALUE('City Lookup'[City], "All Cities")
			VAR CurrentYear = SELECTEDVALUE('City Metrics'[Year], 2024)
			
			
			VAR LivabilityScore = [Avg Livability Score]
			VAR HousingScore = [Avg Housing Affordability]
			VAR TransitScore = [Avg Transit Score]
			VAR GreenScore = [Avg Green Space]
			VAR EmissionsScore = [Avg Emissions]
			
			
			VAR BaselineScore = (LivabilityScore + HousingScore + TransitScore + GreenScore + EmissionsScore) / 5
			
			
			VAR MaxScore = MAX(LivabilityScore, MAX(HousingScore, MAX(TransitScore, MAX(GreenScore, EmissionsScore))))
			VAR StrongestDimension = 
			    SWITCH(
			        TRUE(),
			        MaxScore = LivabilityScore, "Livability Index",
			        MaxScore = HousingScore, "Housing Affordability",
			        MaxScore = TransitScore, "Transit Quality",
			        MaxScore = GreenScore, "Green Space",
			        MaxScore = EmissionsScore, "Emissions",
			        "performance"
			    )
			
			
			VAR MinScore = MIN(LivabilityScore, MIN(HousingScore, MIN(TransitScore, MIN(GreenScore, EmissionsScore))))
			VAR WeakestDimension = 
			    SWITCH(
			        TRUE(),
			        MinScore = LivabilityScore, "Livability Index",
			        MinScore = HousingScore, "Housing Affordability",
			        MinScore = TransitScore, "Transit Quality",
			        MinScore = GreenScore, "Green Space",
			        MinScore = EmissionsScore, "Emissions",
			        "dimension"
			    )
			
			VAR AltText = 
			    "Pentagon radar chart showing five urban performance dimensions for " & CityName & " in " & CurrentYear & ". " &
			    "Transit Quality: " & FORMAT(TransitScore, "0.0") & "%, " &
			    "Livability Index: " & FORMAT(LivabilityScore, "0.0") & "%, " &
			    "Green Space: " & FORMAT(GreenScore, "0.0") & "%, " &
			    "Housing Affordability: " & FORMAT(HousingScore, "0.0") & "%, " &
			    "Emissions: " & FORMAT(EmissionsScore, "0.0") & "%. " &
			    "Overall baseline is " & FORMAT(BaselineScore, "0.0") & "%. " &
			    "Strongest dimension is " & StrongestDimension & " at " & FORMAT(MaxScore, "0.0") & "%. " &
			    "Weakest dimension is " & WeakestDimension & " at " & FORMAT(MinScore, "0.0") & "%. " &
			    "The chart uses a 0-100% scale with concentric circles at 25%, 50%, 75%, and 100% for reference."
			
			RETURN
			AltText
			```
		lineageTag: 49024795-385f-4b01-8bb9-0584db3ddf93

	measure 'Alt Text - Page 2 Card Baseline' = ```
			
			VAR CurrentCity = SELECTEDVALUE('City Lookup'[City], "All Cities")
			VAR SelectedYear = SELECTEDVALUE('City Metrics'[Year], 2024)
			
			
			VAR LivabilityScore = [Avg Livability Score]
			VAR HousingScore = [Avg Housing Affordability]
			VAR TransitScore = [Avg Transit Score]
			VAR GreenScore = [Avg Green Space]
			VAR EmissionsScore = [Avg Emissions]
			VAR BaselineScore = (LivabilityScore + HousingScore + TransitScore + GreenScore + EmissionsScore) / 5
			
			
			VAR PrevYear = SelectedYear - 1
			VAR PrevLiv = CALCULATE([Avg Livability Score], 'City Lookup'[City] = CurrentCity, 'City Metrics'[Year] = PrevYear)
			VAR PrevHous = CALCULATE([Avg Housing Affordability], 'City Lookup'[City] = CurrentCity, 'City Metrics'[Year] = PrevYear)
			VAR PrevTrans = CALCULATE([Avg Transit Score], 'City Lookup'[City] = CurrentCity, 'City Metrics'[Year] = PrevYear)
			VAR PrevGreen = CALCULATE([Avg Green Space], 'City Lookup'[City] = CurrentCity, 'City Metrics'[Year] = PrevYear)
			VAR PrevEmis = CALCULATE([Avg Emissions], 'City Lookup'[City] = CurrentCity, 'City Metrics'[Year] = PrevYear)
			VAR PrevBaseline = (PrevLiv + PrevHous + PrevTrans + PrevGreen + PrevEmis) / 5
			
			VAR YoYChange = BaselineScore - PrevBaseline
			VAR YoYDirection = IF(YoYChange >= 0, "increased", "decreased")
			
			
			VAR Baseline2015 = 
			    VAR Liv2015 = CALCULATE([Avg Livability Score], 'City Lookup'[City] = CurrentCity, 'City Metrics'[Year] = 2015)
			    VAR Hous2015 = CALCULATE([Avg Housing Affordability], 'City Lookup'[City] = CurrentCity, 'City Metrics'[Year] = 2015)
			    VAR Trans2015 = CALCULATE([Avg Transit Score], 'City Lookup'[City] = CurrentCity, 'City Metrics'[Year] = 2015)
			    VAR Green2015 = CALCULATE([Avg Green Space], 'City Lookup'[City] = CurrentCity, 'City Metrics'[Year] = 2015)
			    VAR Emis2015 = CALCULATE([Avg Emissions], 'City Lookup'[City] = CurrentCity, 'City Metrics'[Year] = 2015)
			    RETURN (Liv2015 + Hous2015 + Trans2015 + Green2015 + Emis2015) / 5
			
			VAR TenYearChange = BaselineScore - Baseline2015
			VAR TenYearDirection = IF(TenYearChange >= 0, "improvement", "decline")
			
			VAR AltText = 
			    "Card showing Overall Baseline for " & CurrentCity & " in " & SelectedYear & ". " &
			    "Current baseline score is " & FORMAT(BaselineScore, "0.0") & ", representing the average across five urban dimensions. " &
			    "Year-over-year change is " & FORMAT(ABS(YoYChange), "0.0") & " points (" & YoYDirection & " from " & FORMAT(PrevBaseline, "0.0") & " in " & PrevYear & "). " &
			    "Over the 10-year period from 2015 to 2024, the baseline has " & YoYDirection & " by " & FORMAT(ABS(TenYearChange), "0.0") & " points from " & FORMAT(Baseline2015, "0.0") & ". " &
			    "The card includes a sparkline showing the historical trend from 2015 to 2024. " &
			    "A star icon represents overall urban performance."
			
			RETURN
			AltText
			```
		lineageTag: a1de7cbb-06e3-4c89-a36b-e49475586688

	measure 'Alt Text - Page 2 Card Livability' = ```
			
