			    <text x='45' y='19' text-anchor='middle' font-family='Segoe UI,system-ui,sans-serif' font-size='14' font-weight='600' letter-spacing='-0.01em' fill='" & _TextColor & "'>" & FormattedValue & "</text>
			    </svg>"
			
			RETURN SVGOutput
			```
		lineageTag: d1d16aaa-90bb-44b0-ba0b-9cc15a1072e2
		dataCategory: ImageUrl

	measure 'Page 4 - Emissions YoY Pill' = ```
			
			VAR CurrentYear = SELECTEDVALUE('City Metrics'[Year])
			VAR PrevYear = CurrentYear - 1
			VAR CurrentValue = [Avg Emissions]
			VAR PrevValue = 
			    CALCULATE(
			        [Avg Emissions],
			        'City Metrics'[Year] = PrevYear
			    )
			VAR Change = CurrentValue - PrevValue
			VAR HasPrevious = NOT(ISBLANK(PrevValue))
			
			VAR AllYearsYoY = 
			    CALCULATETABLE(
			        ADDCOLUMNS(
			            VALUES('City Metrics'[Year]),
			            "@YoYChange", 
			                VAR Curr = CALCULATE([Avg Emissions], 'City Metrics'[Year] = 'City Metrics'[Year])
			                VAR Prev = CALCULATE([Avg Emissions], 'City Metrics'[Year] = 'City Metrics'[Year] - 1)
			                RETURN Curr - Prev
			        ),
			        ALLSELECTED('City Lookup'[City])
			    )
			
			// ⚠️ ATENÇÃO: Para EMISSIONS, quanto MENOR melhor, então invertemos a lógica
			VAR Top3Positive = TOPN(3, FILTER(AllYearsYoY, [@YoYChange] < 0), [@YoYChange], ASC)  // Negativos são bons
			VAR Top3Negative = TOPN(3, FILTER(AllYearsYoY, [@YoYChange] > 0), [@YoYChange], DESC) // Positivos são ruins
			
			VAR IsTop3Positive = COUNTROWS(FILTER(Top3Positive, [Year] = CurrentYear)) > 0
			VAR IsTop3Negative = COUNTROWS(FILTER(Top3Negative, [Year] = CurrentYear)) > 0
			
			VAR _BgColor = 
			    IF(NOT(HasPrevious), "transparent",
			    IF(IsTop3Positive, "#E3F2FD",     
			    IF(IsTop3Negative, "#FFEBEE",     
			    "transparent")))
			
			VAR _TextColor = 
			    IF(NOT(HasPrevious), "#9E9E9E",
			    IF(IsTop3Positive, "#1565C0",     
			    IF(IsTop3Negative, "#C62828",     
			    "#424242")))
			
			VAR FormattedValue = 
			    IF(NOT(HasPrevious), "—",
			    FORMAT(Change, "+0.0;-0.0"))
			
			VAR SVGOutput = 
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='90' height='28'>
			    <rect x='0' y='0' width='90' height='28' rx='14' fill='" & _BgColor & "'/>
			    <text x='45' y='19' text-anchor='middle' font-family='Segoe UI,system-ui,sans-serif' font-size='14' font-weight='600' letter-spacing='-0.01em' fill='" & _TextColor & "'>" & FormattedValue & "</text>
			    </svg>"
			
			RETURN SVGOutput
			```
		lineageTag: 50b64f0e-e694-48c8-8518-a07889153c5d
		dataCategory: ImageUrl

