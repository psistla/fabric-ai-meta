	measure 'Page 4 - Overall Trend Sparkline' = ```
			
			VAR CurrentCity = SELECTEDVALUE('City Lookup'[City])
			VAR CurrentYear = SELECTEDVALUE('City Metrics'[Year])
			
			VAR XMinYear = 2015
			VAR XMaxYear = CurrentYear 
			
			
			VAR SparklineTable = 
			    ADDCOLUMNS(
			        CALCULATETABLE(
			            FILTER(
			                ALL('City Metrics'[Year]),
			                'City Metrics'[Year] >= 2015 && 'City Metrics'[Year] <= CurrentYear
			            ),
			            'City Lookup'[City] = CurrentCity
			        ),
			        "@Year", 'City Metrics'[Year],
			        "@OverallScore", 
			            VAR L = CALCULATE([Avg Livability Score])
			            VAR A = CALCULATE([Avg Housing Affordability])
			            VAR T = CALCULATE([Avg Transit Score])
			            VAR E = 100 - CALCULATE([Avg Emissions])
			            VAR G = CALCULATE([Avg Green Space])
			            RETURN (L + A + T + E + G) / 5,
			        "@X", 5 + INT(74 * DIVIDE('City Metrics'[Year] - XMinYear, CurrentYear - XMinYear))
			    )
			
			VAR YMinValue = MINX(SparklineTable, [@OverallScore])
			VAR YMaxValue = MAXX(SparklineTable, [@OverallScore])
			VAR YRange = YMaxValue - YMinValue
			VAR SafeRange = IF(YRange = 0, 1, YRange)
			
			VAR SparklineTableWithY = 
			    ADDCOLUMNS(
			        SparklineTable,
			        "@Y", 4 + INT(16 * DIVIDE([@OverallScore] - YMinValue, SafeRange))
			    )
			
			VAR Points = 
			    CONCATENATEX(
			        SparklineTableWithY,
			        [@X] & "," & (24 - [@Y]),
			        " ",
			        [@Year],
			        ASC
			    )
			
			VAR LastX = MAXX(SparklineTableWithY, [@X])
			
			
			VAR LowYear = MINX(FILTER(SparklineTableWithY, [@OverallScore] = YMinValue), [@Year])
			VAR LowX = MINX(FILTER(SparklineTableWithY, [@Year] = LowYear), [@X])
			VAR LowY = 24 - MINX(FILTER(SparklineTableWithY, [@Year] = LowYear), [@Y])
			
			
			VAR PeakYear = MAXX(FILTER(SparklineTableWithY, [@OverallScore] = YMaxValue), [@Year])
			VAR PeakX = MAXX(FILTER(SparklineTableWithY, [@Year] = PeakYear), [@X])
			VAR PeakY = 24 - MAXX(FILTER(SparklineTableWithY, [@Year] = PeakYear), [@Y])
			
			VAR GradID = "gradBase" & SUBSTITUTE(SUBSTITUTE(CurrentCity, " ", ""), "-", "") & CurrentYear
			
			
			VAR BulletLow = 
			    IF(
			        CurrentYear > 2015,
			        "<circle cx='" & LowX & "' cy='" & LowY & "' r='3' fill='%23C75B5B' stroke='white' stroke-width='1.5'>" &
			        "<animate attributeName='opacity' from='0' to='1' dur='0.5s' begin='1s' fill='freeze' />" &
			        "</circle>",
			        ""
			    )
			
			VAR BulletPeak = 
			    IF(
			        CurrentYear > 2015,
			        "<circle cx='" & PeakX & "' cy='" & PeakY & "' r='3' fill='%230066CC' stroke='white' stroke-width='1.5'>" &
			        "<animate attributeName='opacity' from='0' to='1' dur='0.5s' begin='1s' fill='freeze' />" &
			        "</circle>",
			        ""
			    )
			
			VAR SVG_Raw =
			    "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 84 28'>" &
			    "<defs>" &
			    "<linearGradient id='" & GradID & "' x1='0' y1='0' x2='0' y2='24' gradientUnits='userSpaceOnUse'>" &
			    "<stop stop-color='%230066CC' offset='0' />" &
			    "<stop stop-color='transparent' offset='1' />" &
			    "</linearGradient>" &
			    "</defs>" &
			    
			  
			    "<polyline fill='url(%23" & GradID & ")' fill-opacity='0.18' " &
			    "stroke='none' " &
			    "points='0 24 " & Points & " " & LastX & " 24'>" &
			    "<animate attributeName='fill-opacity' from='0' to='0.18' dur='0.5s' begin='1s' fill='freeze' />" &
			    "</polyline>" &
			    
			    
			    "<polyline fill='none' " &
			    "stroke='%23B8B8B8' stroke-width='0.9' stroke-linecap='round' stroke-linejoin='round' " &
			    "points='" & Points & "' " &
			    "stroke-dasharray='500' stroke-dashoffset='500'>" &
			    "<animate attributeName='stroke-dashoffset' from='500' to='0' dur='1.2s' begin='0s' fill='freeze' />" &
			    "</polyline>" &
			    
			    BulletLow &
			    BulletPeak &
			    "</svg>"
			
			VAR SVGImageURL = 
			    IF(
			        NOT(ISBLANK(CurrentCity)) && CurrentYear >= 2015,
			        "data:image/svg+xml;utf8," & SVG_Raw,
			        BLANK()
			    )
			
			RETURN SVGImageURL
			```
		lineageTag: 7dc45f83-d39c-4185-9169-6807d98d670a
		dataCategory: ImageUrl

	measure 'Page 4 - Livability Peak Card' = ```
			
			VAR CurrentCity = SELECTEDVALUE('City Lookup'[City])
			
			VAR PeakYear = CALCULATE(MAXX(VALUES('City Metrics'[Year]), 'City Metrics'[Year]), TOPN(1, VALUES('City Metrics'[Year]), [Avg Livability Score], DESC))
			VAR PeakValue = CALCULATE([Avg Livability Score], 'City Metrics'[Year] = PeakYear)
			VAR LowYear = CALCULATE(MAXX(VALUES('City Metrics'[Year]), 'City Metrics'[Year]), TOPN(1, VALUES('City Metrics'[Year]), [Avg Livability Score], ASC))
			VAR LowValue = CALCULATE([Avg Livability Score], 'City Metrics'[Year] = LowYear)
			VAR Range = PeakValue - LowValue
			VAR CurrentValue = CALCULATE([Avg Livability Score], 'City Metrics'[Year] = 2024)
			VAR IsImproving = CurrentValue >= PeakValue * 0.95
			VAR ActionPlan = IF(IsImproving, "Maintain trajectory via community programs & infrastructure.", "Reverse decline: review safety, healthcare, cultural funding.")
			
			VAR HTMLCard = 
			"<div style='font-family:Segoe UI,sans-serif;background:#0A1628;border-radius:8px;padding:12px;height:100%;box-sizing:border-box;position:relative;overflow:hidden;cursor:pointer;'>" &
			
			  "<style>" &
			    ".card-content-p4-liv { transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1); }" &
			    ".card-container-p4-liv:hover .card-content-p4-liv { transform: translateY(-100%); }" &
			    ".tooltip-overlay-p4-liv { " &
			        "position: absolute; top: 100%; left: 0; width: 100%; height: 100%; " &
			        "background: #0A1628; color: white; padding: 12px; " &
			        "transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1); " &
			        "display: flex; flex-direction: column; justify-content: center; box-sizing: border-box;" &
			    "}" &
			    ".card-container-p4-liv:hover .tooltip-overlay-p4-liv { transform: translateY(-100%); }" &
			  "</style>" &
			
			  "<div class='card-container-p4-liv' style='position:relative;width:100%;height:100%;overflow:hidden;'>" &
			    
			    "<div class='card-content-p4-liv' style='height:100%;'>" &
			      "<div style='display:flex;align-items:center;gap:6px;margin-bottom:8px;'>" &
			        "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#4A9B9B' stroke-width='2'><path d='M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2'></path><circle cx='9' cy='7' r='4'></circle></svg>" &
			        "<div style='font-size:10px;font-weight:600;color:#8BA3B8;text-transform:uppercase;'>Livability</div>" &
			      "</div>" &
			      "<div style='margin-bottom:6px;'>" &
			        "<div style='font-size:8px;color:#7D92A8;'>⭐ Peak</div>" &
			        "<div style='font-size:18px;font-weight:700;color:#FFFFFF;line-height:1;'>" & PeakYear & ": " & FORMAT(PeakValue, "0.0") & "</div>" &
			      "</div>" &
			      "<div style='margin-bottom:6px;'>" &
			        "<div style='font-size:8px;color:#7D92A8;'>▼ Low</div>" &
			        "<div style='font-size:13px;font-weight:600;color:#C5D3E0;line-height:1;'>" & LowYear & ": " & FORMAT(LowValue, "0.0") & "</div>" &
			      "</div>" &
			      "<div style='display:flex;justify-content:space-between;padding:6px 0;border-top:1px solid rgba(255,255,255,0.1);border-bottom:1px solid rgba(255,255,255,0.1);margin-bottom:8px;'>" &
			        "<div style='font-size:8px;font-weight:600;color:#7D92A8;text-transform:uppercase;'>RANGE</div>" &
			        "<div style='font-size:13px;font-weight:700;color:#FFFFFF;'>" & FORMAT(Range, "0.0") & "</div>" &
			      "</div>" &
			      "<div style='background:rgba(74,155,155,0.12);border-radius:4px;padding:8px;border-left:2px solid #4A9B9B;'>" &
			        "<div style='font-size:7px;font-weight:600;color:#4A9B9B;margin-bottom:3px;text-transform:uppercase;letter-spacing:0.5px;'>Action</div>" &
			        "<div style='font-size:8px;line-height:1.35;color:#B8C9D9;'>" & ActionPlan & "</div>" &
			      "</div>" &
			    "</div>" &
			
			    "<div class='tooltip-overlay-p4-liv'>" &
			      "<div style='font-size:10px;font-weight:700;margin-bottom:6px;border-bottom:1px solid rgba(255,255,255,0.3);padding-bottom:4px;'>10-Year Analysis</div>" &
			      "<p style='font-size:8px;line-height:1.4;margin:0;font-weight:400;'>" &
			        "Peaked in <strong>" & PeakYear & "</strong> at <strong>" & FORMAT(PeakValue, "0.0") & " pts</strong>. " &
			        "The <strong>" & FORMAT(Range, "0.0") & " pt range</strong> indicates " &
			        IF(Range > 3, "significant volatility", "stability") & " over the decade." &
			      "</p>" &
			      "<div style='margin-top:8px;font-size:8px;opacity:0.9;'>" &
			        "<strong>Status:</strong> " & IF(IsImproving, "Near peak performance", "Below historical peak") &
			      "</div>" &
			    "</div>" &
			
			  "</div>" &
			"</div>"
			
			RETURN IF(NOT(ISBLANK(CurrentCity)), HTMLCard, BLANK())
			```
		lineageTag: e51ac314-b0c2-4e04-bd57-1ced06f2ff15

