			    '>City Rankings</div>
			    <div style='
			        font-size: 12px;
			        color: #64748B;
			        font-weight: 400;
			    '>
			        <span style='color: #64748B;'>City:</span> 
			        <span style='font-weight: 600; color: #0A1628;'>" & SelectedCity & "</span>
			        <span style='margin: 0 8px; color: #CBD5E1;'>•</span>
			        <span style='color: #64748B;'>Year:</span> 
			        <span style='font-weight: 600; color: #0A1628;'>" & SelectedYear & "</span>
			    </div>
			</div>"
			```
		lineageTag: 5ac2f3b3-1362-491f-a2d1-c1842dd46557

	measure 'Page 2 - Temporal Analysis - Title' = ```
			
			VAR TrendValue = [Analysis - Trend Direction (Livability)]
			VAR TrendEmoji = 
			    SWITCH(
			        TrendValue,
			        "improving", "↗",
			        "declining", "↘",
			        "stable", "→",
			        ""
			    )
			
			RETURN
			"Livability is " & TrendValue & " " & TrendEmoji
			```
		lineageTag: 1460ee4f-2835-43b7-9eea-20c9c6fe54c5

	measure 'Page 2 - Temporal Analysis - Subtitle' = ```
			
			VAR PctChange = [Analysis - Period Change %]
			VAR YearsAboveAvg = [Analysis - Years Above Avg (Livability)]
			
			VAR YearlyScores = 
			    ADDCOLUMNS(
			        VALUES('City Metrics'[Year]),
			        "@Score", [Avg Livability Score]
			    )
			
			VAR BestYear = 
			    MAXX(
			        TOPN(1, YearlyScores, [@Score], DESC),
			        'City Metrics'[Year]
			    )
			    
			VAR BestScore = 
			    MAXX(
			        TOPN(1, YearlyScores, [@Score], DESC),
			        [@Score]
			    )
			
			VAR WorstYear = 
			    MAXX(
			        TOPN(1, YearlyScores, [@Score], ASC),
			        'City Metrics'[Year]
			    )
			    
			VAR WorstScore = 
			    MAXX(
			        TOPN(1, YearlyScores, [@Score], ASC),
			        [@Score]
			    )
			
			RETURN
			FORMAT(PctChange, "+0.0%;-0.0%") & " over 10 years • " &
			"Best: " & BestYear & " (" & FORMAT(BestScore, "0.0") & ") • " &
			"Worst: " & WorstYear & " (" & FORMAT(WorstScore, "0.0") & ") • " &
			FORMAT(YearsAboveAvg, "0") & " of 10 years above avg"
			```
		lineageTag: b63a9e75-e98d-455d-8d2a-e2e2e99679fc

