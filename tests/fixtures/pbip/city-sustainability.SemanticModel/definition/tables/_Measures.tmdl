	/// Main line - shows selected city(ies) metric
	measure 'Selected City Metric' = ```
			
			[Selected Metric]
			
			```
		formatString: 0.0
		lineageTag: f9d671b1-287e-4370-98b8-9441502de0b3

	/// Benchmark line - always shows all cities average regardless of selection
	measure 'All Cities Benchmark' = ```
			
			CALCULATE(
			    [Selected Metric],
			    ALL('City Lookup'[City])
			)
			
			```
		formatString: 0.0
		lineageTag: 67ad314a-c718-4685-8168-0424989fb344

	/// Calculate trend direction for selected city
	measure 'Analysis - Trend Direction' = ```
			
			VAR FirstYear = CALCULATE([Selected City Metric], 'City Metrics'[Year] = 2015)
			VAR LastYear = CALCULATE([Selected City Metric], 'City Metrics'[Year] = 2024)
			VAR Change = LastYear - FirstYear
			
			RETURN
			SWITCH(
			    TRUE(),
			    Change > 2, "improving",
			    Change < -2, "declining",
			    "stable"
			)
			
			```
		lineageTag: 1107e55e-fb20-47d0-a07f-c238c4d002a9

	/// Calculate percentage change from 2015 to 2024
	measure 'Analysis - Period Change %' = ```
			
			VAR FirstYear = CALCULATE([Selected City Metric], 'City Metrics'[Year] = 2015)
			VAR LastYear = CALCULATE([Selected City Metric], 'City Metrics'[Year] = 2024)
			VAR Change = LastYear - FirstYear
			VAR PctChange = DIVIDE(Change, FirstYear, 0)
			
			RETURN
			PctChange
			
			```
		formatString: 0.0%
		lineageTag: 12632561-514e-40e4-aec0-270db5fa8577

	/// Find the year with highest value for selected metric
	measure 'Analysis - Peak Year' = ```
			
			VAR MaxValue = MAXX(ALL('City Metrics'[Year]), [Selected City Metric])
			VAR PeakYear = 
			    CALCULATE(
			        SELECTEDVALUE('City Metrics'[Year]),
			        FILTER(ALL('City Metrics'[Year]), [Selected City Metric] = MaxValue)
			    )
			
			RETURN
			PeakYear
			
			```
		formatString: 0
		lineageTag: 765f3c7f-a8ac-4959-a16e-5758e04d1709

	/// Find the year with lowest value for selected metric
	measure 'Analysis - Lowest Year' = ```
			
			VAR MinValue = MINX(ALL('City Metrics'[Year]), [Selected City Metric])
			VAR LowestYear = 
			    CALCULATE(
			        SELECTEDVALUE('City Metrics'[Year]),
			        FILTER(ALL('City Metrics'[Year]), [Selected City Metric] = MinValue)
			    )
			
			RETURN
			LowestYear
			
			```
		formatString: 0
		lineageTag: 93605a37-95ef-4fd7-bde5-3df295af03de

