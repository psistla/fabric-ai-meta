	/// Dynamic subtitle for ranking table with distribution insights
	measure 'Page 1 - Table - Subtitle' = ```
			VAR CurrentYear = MAX('City Metrics'[Year])
			VAR BenchmarkValue = 
			    CALCULATE(
			        [All Cities Benchmark],
			        'City Metrics'[Year] = CurrentYear
			    )
			
			
			VAR AllCitiesWithTier = 
			    ADDCOLUMNS(
			        ALL('City Lookup'[City]),
			        "@Value", CALCULATE([Selected Metric], 'City Metrics'[Year] = CurrentYear),
			        "@Rank", RANKX(
			            ALL('City Lookup'[City]),
			            CALCULATE([Selected Metric], 'City Metrics'[Year] = CurrentYear),
			            ,
			            DESC,
			            DENSE
			        )
			    )
			
			VAR TopTier = COUNTROWS(FILTER(AllCitiesWithTier, [@Rank] <= 4))  
			VAR MiddleTier = COUNTROWS(FILTER(AllCitiesWithTier, [@Rank] >= 5 && [@Rank] <= 8))  
			VAR BottomTier = COUNTROWS(FILTER(AllCitiesWithTier, [@Rank] >= 9))  
			
			
			VAR PrevYear = CurrentYear - 1
			VAR CitiesWithGrowth = 
			    ADDCOLUMNS(
			        ALL('City Lookup'[City]),
			        "@CurrentValue", CALCULATE([Selected Metric], 'City Metrics'[Year] = CurrentYear),
			        "@PrevValue", CALCULATE([Selected Metric], 'City Metrics'[Year] = PrevYear),
			        "@Growth", 
			            CALCULATE([Selected Metric], 'City Metrics'[Year] = CurrentYear) - 
			            CALCULATE([Selected Metric], 'City Metrics'[Year] = PrevYear)
			    )
			VAR TopImprover = TOPN(1, CitiesWithGrowth, [@Growth], DESC)
			VAR TopImproverName = MAXX(TopImprover, 'City Lookup'[City])
			VAR TopImprovementValue = MAXX(TopImprover, [@Growth])
			
			
			VAR CitiesWithGap = 
			    ADDCOLUMNS(
			        ALL('City Lookup'[City]),
			        "@Value", CALCULATE([Selected Metric], 'City Metrics'[Year] = CurrentYear),
			        "@Gap", CALCULATE([Selected Metric], 'City Metrics'[Year] = CurrentYear) - BenchmarkValue
			    )
			VAR MaxGapCity = TOPN(1, CitiesWithGap, ABS([@Gap]), DESC)
			VAR MaxGapCityName = MAXX(MaxGapCity, 'City Lookup'[City])
			VAR MaxGapValue = MAXX(MaxGapCity, [@Gap])
			
			
			VAR SubtitleText = 
			    "Benchmark: " & FORMAT(BenchmarkValue, "0.0") & " pts • " &
			    "Distribution: " & TopTier & " leaders, " & MiddleTier & " mid-tier, " & BottomTier & " need improvement" &
			    IF(
			        NOT(ISBLANK(TopImprovementValue)) && TopImprovementValue > 0.5,
			        " • Biggest YoY gain: " & TopImproverName & " (+" & FORMAT(TopImprovementValue, "0.0") & ")",
			        ""
			    ) &
			    IF(
			        NOT(ISBLANK(MaxGapValue)),
			        " • Widest gap: " & MaxGapCityName & " (" & FORMAT(MaxGapValue, "+0.0;-0.0") & " vs avg)",
			        ""
			    )
			
			RETURN
			SubtitleText
			```
		lineageTag: a02c2805-ca82-4ba0-97c0-9f9d40bd43b8

