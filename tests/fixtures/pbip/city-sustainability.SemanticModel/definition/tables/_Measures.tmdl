	measure 'Alt Text - Page 3 Combined Livability' = ```
			
			VAR CurrentCity = SELECTEDVALUE('City Lookup'[City], "All Cities")
			VAR SelectedYear = SELECTEDVALUE('City Metrics'[Year], 2024)
			
			VAR CurrentValue = [Avg Livability Score]
			VAR CurrentRank = [Rank - Livability]
			VAR TotalCities = DISTINCTCOUNT('City Lookup'[City])
			
			VAR PrevYear = SelectedYear - 1
			VAR PrevRank = CALCULATE([Rank - Livability], 'City Metrics'[Year] = PrevYear)
			VAR RankChange = PrevRank - CurrentRank
			VAR RankDirection = 
			    IF(ISBLANK(RankChange), "no change",
			        IF(RankChange > 0, "improved", 
			            IF(RankChange < 0, "declined", "unchanged")))
			
			VAR TopCity = 
			    CALCULATE(
			        SELECTEDVALUE('City Lookup'[City]),
			        TOPN(1, ALL('City Lookup'[City]), [Avg Livability Score], DESC)
			    )
			VAR TopScore = 
			    CALCULATE([Avg Livability Score], 'City Lookup'[City] = TopCity)
			
			VAR AltText = 
			    "Bar chart and ranking card for Livability Index dimension. " &
			    "The bar chart displays all " & TotalCities & " cities ranked by their " & SelectedYear & " livability scores, with " & CurrentCity & " highlighted in blue at position #" & CurrentRank & " with a score of " & FORMAT(CurrentValue, "0.0") & " points. " &
			    "The top-ranked city is " & TopCity & " with " & FORMAT(TopScore, "0.0") & " points. " &
			    "Livability measures overall quality of life including safety, healthcare, education, and cultural amenities. " &
			    IF(NOT ISBLANK(RankChange), 
			        "Year-over-year, " & CurrentCity & " " & RankDirection & " by " & ABS(RankChange) & " position" & IF(ABS(RankChange) = 1, "", "s") & " from rank #" & PrevRank & " in " & PrevYear & ". ",
			        "") &
			    "The ranking card shows the selected city's position, total cities count (" & TotalCities & "), and year-over-year change indicator. " &
			    "Higher scores and lower rank numbers indicate better livability."
			
			RETURN
			AltText
			
			```
		lineageTag: 9e8e76a2-d3bb-403d-a5af-e047c4a394ed

