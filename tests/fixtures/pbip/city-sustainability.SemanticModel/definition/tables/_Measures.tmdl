	measure 'Alt Text - Page 1 Card Strongest Dimension' = ```
			
			VAR CurrentCity = SELECTEDVALUE('City Lookup'[City], "All Cities")
			VAR SelectedYear = SELECTEDVALUE('City Metrics'[Year], 2024)
			VAR DimName = [Strongest Dimension Name]
			VAR DimValue = [Strongest Dimension Value]
			VAR GapText = [Strongest Dimension Gap]
			
			VAR RawGapText = [Strongest Dimension Gap]
			VAR GapValue = IFERROR(VALUE(PATHITEM(SUBSTITUTE(RawGapText, " ", "|"), 1)), 0)
			
			VAR IsGood = 
			    SWITCH(TRUE(),
			        ISBLANK(RawGapText), 1,
			        (DimName = "Housing Affordability" || DimName = "Emissions") && GapValue <= 0, 1,
			        (DimName = "Housing Affordability" || DimName = "Emissions") && GapValue > 0, 0,
			        GapValue >= 0, 1, 
			        0
			    )
			
			VAR PerformanceDescription = IF(IsGood = 1, "competitive advantage", "area requiring attention")
			
			VAR AltText = 
			    "Card showing Strongest Dimension for " & CurrentCity & " in " & SelectedYear & ". " &
			    "The strongest performing dimension is " & IF(ISBLANK(DimName), "not available", DimName) & ". " &
			    "Dimension value is " & IF(ISBLANK(DimValue), "not available", DimValue) & ". " &
			    "Gap versus All Cities average is " & IF(ISBLANK(GapText), "not available", GapText) & ", representing this city's " & PerformanceDescription & ". " &
			    "A flame icon represents the strongest performing area. The card includes a hover tooltip with context-specific insights. " &
			    "This metric identifies the city's most significant competitive advantage across all urban dimensions."
			
			RETURN
			AltText
			```
		lineageTag: e62bcb58-ed48-4448-bb3c-a79e9e37c5db

	measure 'Alt Text - Page 1 Card Weakest Dimension' = ```
			
			VAR CurrentCity = SELECTEDVALUE('City Lookup'[City], "All Cities")
			VAR SelectedYear = SELECTEDVALUE('City Metrics'[Year], 2024)
			VAR DimName = [Weakest Dimension Name]
			VAR DimValue = [Weakest Dimension Value]
			VAR GapText = [Weakest Dimension Gap]
			
			VAR RawGapText = [Weakest Dimension Gap]
			VAR GapValue = IFERROR(VALUE(PATHITEM(SUBSTITUTE(RawGapText, " ", "|"), 1)), 0)
			
			VAR IsGood = 
			    SWITCH(TRUE(),
			        ISBLANK(RawGapText), 1,
			        (DimName = "Housing Affordability" || DimName = "Emissions") && GapValue <= 0, 1,
			        (DimName = "Housing Affordability" || DimName = "Emissions") && GapValue > 0, 0,
			        GapValue >= 0, 1, 
			        0
			    )
			
			VAR PerformanceDescription = IF(IsGood = 1, "relative weakness", "primary development opportunity")
			
			VAR AltText = 
			    "Card showing Weakest Dimension for " & CurrentCity & " in " & SelectedYear & ". " &
			    "The weakest performing dimension is " & IF(ISBLANK(DimName), "not available", DimName) & ". " &
			    "Dimension value is " & IF(ISBLANK(DimValue), "not available", DimValue) & ". " &
			    "Gap versus All Cities average is " & IF(ISBLANK(GapText), "not available", GapText) & ", representing this city's " & PerformanceDescription & ". " &
			    "A home icon represents the area requiring most attention. The card includes a hover tooltip with context-specific improvement recommendations. " &
			    "This metric identifies the dimension with the greatest gap below benchmark, highlighting the primary opportunity for strategic intervention and improvement."
			
			RETURN
			AltText
			```
		lineageTag: 26063b0f-97b3-497c-a7a9-643b610bddb4

	measure 'Page 2 - Notifications Panel' = ```
			
			VAR CurrentCity = SELECTEDVALUE('City Lookup'[City], "All Cities")
			VAR CurrentYear = MAX('City Metrics'[Year])
			VAR PrevYear = CurrentYear - 1
			
			
			VAR LivabilityScore = [Avg Livability Score]
			VAR HousingScore = [Avg Housing Affordability]
			VAR TransitScore = [Avg Transit Score]
			VAR GreenScore = [Avg Green Space]
			VAR EmissionsScore = [Avg Emissions]
			
			
			VAR LivabilityPrev = CALCULATE([Avg Livability Score], 'City Metrics'[Year] = PrevYear)
			VAR HousingPrev = CALCULATE([Avg Housing Affordability], 'City Metrics'[Year] = PrevYear)
			VAR TransitPrev = CALCULATE([Avg Transit Score], 'City Metrics'[Year] = PrevYear)
			VAR GreenPrev = CALCULATE([Avg Green Space], 'City Metrics'[Year] = PrevYear)
			VAR EmissionsPrev = CALCULATE([Avg Emissions], 'City Metrics'[Year] = PrevYear)
			
			VAR LivabilityChange = LivabilityScore - LivabilityPrev
			VAR HousingChange = HousingScore - HousingPrev
			VAR TransitChange = TransitScore - TransitPrev
			VAR GreenChange = GreenScore - GreenPrev
			VAR EmissionsChange = EmissionsScore - EmissionsPrev
			
			
			VAR BaselineScore = (LivabilityScore + HousingScore + TransitScore + GreenScore + EmissionsScore) / 5
			VAR BaselinePrev = (LivabilityPrev + HousingPrev + TransitPrev + GreenPrev + EmissionsPrev) / 5
			VAR BaselineChange = BaselineScore - BaselinePrev
			
			
			VAR MaxScore = MAX(LivabilityScore, MAX(HousingScore, MAX(TransitScore, MAX(GreenScore, EmissionsScore))))
			VAR StrongestDimension = 
			    SWITCH(
			        TRUE(),
			        MaxScore = LivabilityScore, "Livability",
			        MaxScore = HousingScore, "Housing",
			        MaxScore = TransitScore, "Transit",
			        MaxScore = GreenScore, "Green Space",
			        MaxScore = EmissionsScore, "Emissions",
			        "Performance"
			    )
			
			
			VAR MaxChange = MAX(ABS(LivabilityChange), MAX(ABS(HousingChange), MAX(ABS(TransitChange), MAX(ABS(GreenChange), ABS(EmissionsChange)))))
			VAR BiggestMover = 
			    SWITCH(
			        TRUE(),
			        ABS(LivabilityChange) = MaxChange, "Livability",
			        ABS(HousingChange) = MaxChange, "Housing",
			        ABS(TransitChange) = MaxChange, "Transit",
			        ABS(GreenChange) = MaxChange, "Green Space",
			        ABS(EmissionsChange) = MaxChange, "Emissions",
			        "None"
			    )
			VAR BiggestMoverValue = 
			    SWITCH(
			        TRUE(),
			        ABS(LivabilityChange) = MaxChange, LivabilityChange,
			        ABS(HousingChange) = MaxChange, HousingChange,
			        ABS(TransitChange) = MaxChange, TransitChange,
			        ABS(GreenChange) = MaxChange, GreenChange,
			        ABS(EmissionsChange) = MaxChange, EmissionsChange,
			        0
			    )
			
			
			VAR IsGoodChange = 
			    SWITCH(
			        TRUE(),
			        BiggestMover = "Housing" && BiggestMoverValue < 0, TRUE(),  // Housing down = good
			        BiggestMover = "Emissions" && BiggestMoverValue < 0, TRUE(), // Emissions down = good
			        BiggestMover = "Housing" && BiggestMoverValue >= 0, FALSE(), // Housing up = bad
			        BiggestMover = "Emissions" && BiggestMoverValue >= 0, FALSE(), // Emissions up = bad
			        BiggestMoverValue >= 0, TRUE(),  // For Transit/Green/Livability: up = good
			        FALSE()  // For Transit/Green/Livability: down = bad
			    )
			
			VAR AlertColor = IF(IsGoodChange, "#66B2FF", "#FFB74D")
			VAR AlertLabel = IF(BiggestMoverValue >= 0, "Growth", "Decline")
			VAR AlertVerb = IF(IsGoodChange, "Improved", "Declined")
			
			
			VAR MinScore = MIN(LivabilityScore, MIN(HousingScore, MIN(TransitScore, MIN(GreenScore, EmissionsScore))))
			VAR WeakestDimension = 
			    SWITCH(
			        TRUE(),
			        MinScore = LivabilityScore, "Livability",
			        MinScore = HousingScore, "Housing",
			        MinScore = TransitScore, "Transit",
			        MinScore = GreenScore, "Green Space",
			        MinScore = EmissionsScore, "Emissions",
			        "None"
			    )
			
			
			VAR HasAlert1 = ABS(BiggestMoverValue) > 2  // Significant YoY change
			VAR HasAlert2 = BaselineChange <> 0  // Overall baseline movement
			VAR HasAlert3 = MaxScore >= 70  // Strong performer exists
			VAR TotalAlerts = IF(HasAlert1, 1, 0) + IF(HasAlert2, 1, 0) + IF(HasAlert3, 1, 0)
			
			RETURN
			IF(
			    TotalAlerts = 0,
			    "No notifications available",
			    
			"<style>" &
			  "body,html{overflow:hidden!important;margin:0;padding:0;height:100%}" &
			  "*{overflow:hidden!important;scrollbar-width:none!important;box-sizing:border-box}" &
			  "::-webkit-scrollbar{display:none!important;width:0!important;height:0!important}" &
			  "@keyframes slideInRight{from{transform:translateX(30px);opacity:0}to{transform:translateX(0);opacity:1}}" &
			  ".notification-card{animation:slideInRight 0.5s ease-out forwards;opacity:0}" &
			  ".notification-card:nth-child(1){animation-delay:0.1s}" &
			  ".notification-card:nth-child(2){animation-delay:0.3s}" &
			  ".notification-card:nth-child(3){animation-delay:0.5s}" &
			  ".notification-card:nth-child(4){animation-delay:0.7s}" &
			"</style>" &
			
			"<div style='font-family:system-ui,sans-serif;padding:0;background:linear-gradient(180deg, #0F1C2E 0%, #1A2942 50%, #0A1628 100%);height:720px;width:280px;display:flex;flex-direction:column;overflow:hidden!important;margin:0;box-shadow:inset 0 1px 0 rgba(255,255,255,0.05)'>" &
			
			  "<!-- Header -->" &
			  "<div style='padding:18px 20px 14px;border-bottom:1px solid rgba(255,255,255,0.1)'>" &
			    "<div style='font-size:19px;font-weight:700;color:#FFFFFF;margin-bottom:5px;letter-spacing:-0.03em'>City Insights</div>" &
			    "<div style='display:flex;align-items:center;gap:8px'>" &
			      "<div style='font-size:11px;color:rgba(255,255,255,0.65);font-weight:400'>" & CurrentCity & " • " & CurrentYear & "</div>" &
			      "<div style='display:inline-block;background:#0066CC;color:white;padding:2px 8px;border-radius:10px;font-size:10px;font-weight:600;box-shadow:0 2px 4px rgba(0,102,204,0.3)'>" & TotalAlerts & " insight" & IF(TotalAlerts > 1, "s", "") & "</div>" &
			    "</div>" &
			  "</div>" &
			
			  "<!-- Cards -->" &
			  "<div style='padding:16px 20px;flex:1;overflow:hidden;display:flex;flex-direction:column;gap:10px'>" &
			    
			    "<!-- Alert 1: Biggest YoY Mover -->" &
			    IF(HasAlert1, 
			      "<div class='notification-card' style='background:rgba(10,22,40,0.6);border-left:3px solid " & AlertColor & ";border-radius:8px;padding:12px;backdrop-filter:blur(10px);border:1px solid " & IF(IsGoodChange, "rgba(102,178,255,0.15)", "rgba(255,183,77,0.15)") & "'>" &
			        "<div style='display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:7px'>" &
			          "<div style='display:flex;align-items:center;gap:6px'>" &
			            "<svg width='13' height='13' viewBox='0 0 24 24' fill='none' stroke='" & AlertColor & "' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><polyline points='23 6 13.5 15.5 8.5 10.5 1 18'/><polyline points='17 6 23 6 23 12'/></svg>" &
			            "<div style='font-size:9px;font-weight:600;color:" & AlertColor & ";text-transform:uppercase;letter-spacing:0.05em'>" & AlertLabel & "</div>" &
			          "</div>" &
			          "<div style='font-size:8px;color:rgba(255,255,255,0.4)'>YoY</div>" &
			        "</div>" &
			        "<div style='font-size:12px;font-weight:600;color:#FFFFFF;margin-bottom:5px'>" & BiggestMover & " " & AlertVerb & "</div>" &
			        "<div style='font-size:10px;color:rgba(255,255,255,0.65);line-height:1.4'>" & 
			          IF(
			            BiggestMover = "Housing" || BiggestMover = "Emissions",
			            IF(BiggestMoverValue < 0, "Down ", "Up "),  // For Housing/Emissions: down is mentioned positively
			            IF(BiggestMoverValue >= 0, "Up ", "Down ")  // For others: up is mentioned positively
			          ) & 
			          "<span style='font-weight:600;color:" & AlertColor & "'>" & FORMAT(ABS(BiggestMoverValue), "0.0") & " pts</span> " &
			          "from " & PrevYear & " to " & CurrentYear & "." &
			        "</div>" &
			      "</div>", 
			      ""
			    ) &
			    
			    "<!-- Alert 2: Overall Baseline Change -->" &
			    IF(HasAlert2,
			      "<div class='notification-card' style='background:rgba(10,22,40,0.6);border-left:3px solid " & IF(BaselineChange >= 0, "#66B2FF", "#FF6B6B") & ";border-radius:8px;padding:12px;backdrop-filter:blur(10px);border:1px solid " & IF(BaselineChange >= 0, "rgba(102,178,255,0.15)", "rgba(255,107,107,0.15)") & "'>" &
			        "<div style='display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:7px'>" &
			          "<div style='display:flex;align-items:center;gap:6px'>" &
			            "<svg width='13' height='13' viewBox='0 0 24 24' fill='none' stroke='" & IF(BaselineChange >= 0, "#66B2FF", "#FF6B6B") & "' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><polygon points='12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2'></polygon></svg>" &
			            "<div style='font-size:9px;font-weight:600;color:" & IF(BaselineChange >= 0, "#66B2FF", "#FF6B6B") & ";text-transform:uppercase;letter-spacing:0.05em'>Baseline</div>" &
			          "</div>" &
			          "<div style='font-size:8px;color:rgba(255,255,255,0.4)'>" & CurrentYear & "</div>" &
			        "</div>" &
			        "<div style='font-size:12px;font-weight:600;color:#FFFFFF;margin-bottom:5px'>Overall Performance " & IF(BaselineChange >= 0, "Up", "Down") & "</div>" &
			        "<div style='font-size:10px;color:rgba(255,255,255,0.65);line-height:1.4'>" &
			          "Baseline " & IF(BaselineChange >= 0, "rose", "fell") & " " &
			          "<span style='font-weight:600;color:" & IF(BaselineChange >= 0, "#66B2FF", "#FF6B6B") & "'>" & FORMAT(ABS(BaselineChange), "0.0") & " pts</span> to " & FORMAT(BaselineScore, "0.0") & " pts." &
			        "</div>" &
			      "</div>",
			      ""
			    ) &
			    
			    "<!-- Alert 3: Top Performer Dimension -->" &
			    IF(HasAlert3,
			      "<div class='notification-card' style='background:rgba(10,22,40,0.6);border-left:3px solid #66B2FF;border-radius:8px;padding:12px;backdrop-filter:blur(10px);border:1px solid rgba(102,178,255,0.15)'>" &
			        "<div style='display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:7px'>" &
			          "<div style='display:flex;align-items:center;gap:6px'>" &
			            "<svg width='13' height='13' viewBox='0 0 24 24' fill='none' stroke='#66B2FF' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M22 11.08V12a10 10 0 1 1-5.93-9.14'/><polyline points='22 4 12 14.01 9 11.01'/></svg>" &
			            "<div style='font-size:9px;font-weight:600;color:#66B2FF;text-transform:uppercase;letter-spacing:0.05em'>Strength</div>" &
			          "</div>" &
			          "<div style='font-size:8px;color:rgba(255,255,255,0.4)'>" & CurrentYear & "</div>" &
			        "</div>" &
			        "<div style='font-size:12px;font-weight:600;color:#FFFFFF;margin-bottom:5px'>" & StrongestDimension & " Leads</div>" &
			        "<div style='font-size:10px;color:rgba(255,255,255,0.65);line-height:1.4'>" &
			          "Top dimension with <span style='font-weight:600;color:#66B2FF'>" & FORMAT(MaxScore, "0.0") & " pts</span>. " &
			          "Focus area: maintain excellence." &
			        "</div>" &
			      "</div>",
			      ""
			    ) &
			
			    "<!-- Quick Tips Card -->" &
			    "<div class='notification-card' style='background:rgba(255,255,255,0.95);border-left:3px solid #0066CC;border-radius:8px;padding:12px;border:1px solid rgba(255,255,255,0.2);margin-top:auto'>" &
			      "<div style='display:flex;align-items:center;gap:6px;margin-bottom:7px'>" &
			        "<svg width='13' height='13' viewBox='0 0 24 24' fill='none' stroke='#0066CC' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='10'/><path d='M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3'/><line x1='12' y1='17' x2='12.01' y2='17'/></svg>" &
			        "<div style='font-size:9px;font-weight:600;color:#0066CC;text-transform:uppercase;letter-spacing:0.05em'>Priority</div>" &
			      "</div>" &
			      "<div style='font-size:12px;font-weight:600;color:#0A1628;margin-bottom:5px'>Focus Area: " & WeakestDimension & "</div>" &
			      "<div style='font-size:10px;color:#3A4A5A;line-height:1.4'>" &
			        "Lowest dimension at <span style='font-weight:600;color:#0066CC'>" & FORMAT(MinScore, "0.0") & " pts</span>. " &
			        "Strategic intervention here could yield significant improvements." &
			      "</div>" &
			    "</div>" &
			    
			  "</div>" &
			"</div>"
			)
			```
