	measure 'Page 4 - Transit Peak Card' = ```
			
			VAR CurrentCity = SELECTEDVALUE('City Lookup'[City])
			
			VAR PeakYear = CALCULATE(MAXX(VALUES('City Metrics'[Year]), 'City Metrics'[Year]), TOPN(1, VALUES('City Metrics'[Year]), [Avg Transit Score], DESC))
			VAR PeakValue = CALCULATE([Avg Transit Score], 'City Metrics'[Year] = PeakYear)
			VAR LowYear = CALCULATE(MAXX(VALUES('City Metrics'[Year]), 'City Metrics'[Year]), TOPN(1, VALUES('City Metrics'[Year]), [Avg Transit Score], ASC))
			VAR LowValue = CALCULATE([Avg Transit Score], 'City Metrics'[Year] = LowYear)
			VAR Range = PeakValue - LowValue
			VAR CurrentValue = CALCULATE([Avg Transit Score], 'City Metrics'[Year] = 2024)
			VAR IsImproving = CurrentValue >= PeakValue * 0.95
			VAR ActionPlan = IF(IsImproving, "Expand coverage & increase peak frequency.", "Urgent: modernize infrastructure, add routes, improve reliability.")
			
			VAR HTMLCard = 
			"<div style='font-family:Segoe UI,sans-serif;background:#0A1628;border-radius:8px;padding:12px;height:100%;box-sizing:border-box;position:relative;overflow:hidden;cursor:pointer;'>" &
			
			  "<style>" &
			    ".card-content-p4-tra { transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1); }" &
			    ".card-container-p4-tra:hover .card-content-p4-tra { transform: translateY(-100%); }" &
			    ".tooltip-overlay-p4-tra { " &
			        "position: absolute; top: 100%; left: 0; width: 100%; height: 100%; " &
			        "background: #0A1628; color: white; padding: 12px; " &
			        "transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1); " &
			        "display: flex; flex-direction: column; justify-content: center; box-sizing: border-box;" &
			    "}" &
			    ".card-container-p4-tra:hover .tooltip-overlay-p4-tra { transform: translateY(-100%); }" &
			  "</style>" &
			
			  "<div class='card-container-p4-tra' style='position:relative;width:100%;height:100%;overflow:hidden;'>" &
			    
			    "<div class='card-content-p4-tra' style='height:100%;'>" &
			      "<div style='display:flex;align-items:center;gap:6px;margin-bottom:8px;'>" &
			        "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#4A9B9B' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>" &
			          "<path d='M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2'></path>" &
			          "<circle cx='7' cy='17' r='2'></circle>" &
			          "<path d='M9 17h6'></path>" &
			          "<circle cx='17' cy='17' r='2'></circle>" &
			        "</svg>" &
			        "<div style='font-size:10px;font-weight:600;color:#8BA3B8;text-transform:uppercase;'>Transit</div>" &
			      "</div>" &
			      "<div style='margin-bottom:6px;'>" &
			        "<div style='font-size:8px;color:#7D92A8;'>⭐ Peak</div>" &
			        "<div style='font-size:18px;font-weight:700;color:#FFFFFF;line-height:1;'>" & PeakYear & ": " & FORMAT(PeakValue, "0.0") & "</div>" &
			      "</div>" &
			      "<div style='margin-bottom:6px;'>" &
			        "<div style='font-size:8px;color:#7D92A8;'>▼ Low</div>" &
			        "<div style='font-size:13px;font-weight:600;color:#C5D3E0;line-height:1;'>" & LowYear & ": " & FORMAT(LowValue, "0.0") & "</div>" &
			      "</div>" &
			      "<div style='display:flex;justify-content:space-between;padding:6px 0;border-top:1px solid rgba(255,255,255,0.1);border-bottom:1px solid rgba(255,255,255,0.1);margin-bottom:8px;'>" &
			        "<div style='font-size:8px;font-weight:600;color:#7D92A8;text-transform:uppercase;'>RANGE</div>" &
			        "<div style='font-size:13px;font-weight:700;color:#FFFFFF;'>" & FORMAT(Range, "0.0") & "</div>" &
			      "</div>" &
			      "<div style='background:rgba(74,155,155,0.12);border-radius:4px;padding:8px;border-left:2px solid #4A9B9B;'>" &
			        "<div style='font-size:7px;font-weight:600;color:#4A9B9B;margin-bottom:3px;text-transform:uppercase;letter-spacing:0.5px;'>Action</div>" &
			        "<div style='font-size:8px;line-height:1.35;color:#B8C9D9;'>" & ActionPlan & "</div>" &
			      "</div>" &
			    "</div>" &
			
			    "<div class='tooltip-overlay-p4-tra'>" &
			      "<div style='font-size:10px;font-weight:700;margin-bottom:6px;border-bottom:1px solid rgba(255,255,255,0.3);padding-bottom:4px;'>10-Year Analysis</div>" &
			      "<p style='font-size:8px;line-height:1.4;margin:0;font-weight:400;'>" &
			        "Peaked in <strong>" & PeakYear & "</strong> at <strong>" & FORMAT(PeakValue, "0.0") & " pts</strong>. " &
			        "The <strong>" & FORMAT(Range, "0.0") & " pt swing</strong> reflects changes in network coverage and reliability." &
			      "</p>" &
			      "<div style='margin-top:8px;font-size:8px;opacity:0.9;'>" &
			        "<strong>Status:</strong> " & IF(IsImproving, "Strong network", "Network degradation") &
			      "</div>" &
			    "</div>" &
			
			  "</div>" &
			"</div>"
			
			RETURN IF(NOT(ISBLANK(CurrentCity)), HTMLCard, BLANK())
