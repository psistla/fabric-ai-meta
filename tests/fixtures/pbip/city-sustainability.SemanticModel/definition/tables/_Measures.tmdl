	measure 'YoY - Livability' =
			VAR AnoAtual = MAX('City Metrics'[Year])
			VAR AnoAnterior = AnoAtual - 1
			VAR ValorAtual = [Avg Livability Score]
			VAR ValorAnterior = CALCULATE([Avg Livability Score], 'City Metrics'[Year] = AnoAnterior)
			RETURN
			IF(
			    NOT(ISBLANK(ValorAtual)) && NOT(ISBLANK(ValorAnterior)),
			    ValorAtual - ValorAnterior,
			    BLANK()
			)
		formatString: +#,##0.0;-#,##0.0;0
		displayFolder: YoY
		lineageTag: cf569eda-8775-4116-b309-92c259efe503

