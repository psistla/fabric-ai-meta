	measure 'Rank - Livability' =
			VAR CidadeSelecionada = SELECTEDVALUE('City Lookup'[City])
			VAR ValorCidade = CALCULATE([Avg Livability Score], 'City Lookup'[City] = CidadeSelecionada)
			RETURN
			IF(
			    NOT(ISBLANK(ValorCidade)),
			    RANKX(
			        ALL('City Lookup'[City]),
			        CALCULATE([Avg Livability Score]),
			        ,
			        DESC,
			        DENSE
			    ),
			    BLANK()
			)
		formatString: #,##0
		displayFolder: Ranks
		lineageTag: a65a3172-155a-4f45-bba5-8f860f9fab1b

