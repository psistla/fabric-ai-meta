	measure 'Page 4 - Emissions Peak Card' = ```
			
			VAR CurrentCity = SELECTEDVALUE('City Lookup'[City])
			
			VAR PeakYear = CALCULATE(MAXX(VALUES('City Metrics'[Year]), 'City Metrics'[Year]), TOPN(1, VALUES('City Metrics'[Year]), [Avg Emissions], ASC))
			VAR PeakValue = CALCULATE([Avg Emissions], 'City Metrics'[Year] = PeakYear)
			VAR LowYear = CALCULATE(MAXX(VALUES('City Metrics'[Year]), 'City Metrics'[Year]), TOPN(1, VALUES('City Metrics'[Year]), [Avg Emissions], DESC))
			VAR LowValue = CALCULATE([Avg Emissions], 'City Metrics'[Year] = LowYear)
			VAR Range = LowValue - PeakValue
			VAR CurrentValue = CALCULATE([Avg Emissions], 'City Metrics'[Year] = 2024)
			VAR IsImproving = CurrentValue <= PeakValue * 1.05
			VAR ActionPlan = IF(IsImproving, "Sustain: accelerate EV, renewables, industrial standards.", "Prioritize: stricter vehicle standards, public transit, green energy.")
			
			VAR HTMLCard = 
			"<div style='font-family:Segoe UI,sans-serif;background:#0A1628;border-radius:8px;padding:12px;height:100%;box-sizing:border-box;position:relative;overflow:hidden;cursor:pointer;'>" &
			
			  "<style>" &
