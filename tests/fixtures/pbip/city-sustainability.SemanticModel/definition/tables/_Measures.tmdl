	measure 'Card Rank - Livability HTML' = ```
			
			VAR CurrentRank = [Rank - Livability]
			VAR CurrentYear = SELECTEDVALUE('City Metrics'[Year])
			VAR PreviousYearRank = 
			    CALCULATE(
			        [Rank - Livability],
			        'City Metrics'[Year] = CurrentYear - 1
			    )
			VAR RankChange = 
			    IF(
			        NOT(ISBLANK(PreviousYearRank)) && NOT(ISBLANK(CurrentRank)),
			        PreviousYearRank - CurrentRank,
			        BLANK()
			    )
			RETURN
			"<div style='font-family:system-ui,sans-serif;background:white;border-radius:10px;padding:12px 14px;position:relative;overflow:hidden;height:100%;cursor:pointer;'>" &
			
			  "<style>" &
			    ".card-content-rank-livab { transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1); }" &
			    ".card-container-rank-livab:hover .card-content-rank-livab { transform: translateY(-100%); }" &
			    ".tooltip-overlay-rank-livab { " &
			        "position: absolute; top: 100%; left: 0; width: 100%; height: 100%; " &
			        "background: #0066CC; color: white; padding: 14px; " &
			        "transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1); " &
			        "display: flex; flex-direction: column; justify-content: center; box-sizing: border-box;" &
			    "}" &
			    ".card-container-rank-livab:hover .tooltip-overlay-rank-livab { transform: translateY(-100%); }" &
			    
			    
			    "@keyframes countUp-livab {" &
			      "from { opacity: 0; transform: scale(0.5); }" &
			      "to { opacity: 1; transform: scale(1); }" &
			    "}" &
			    ".rank-number-livab {" &
			      "animation: countUp-livab 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);" &
			      "display: inline-block;" &
			    "}" &
			  "</style>" &
			
			  "<div class='card-container-rank-livab' style='position:relative;width:100%;height:100%;overflow:hidden;'>" &
			    
			    "<div class='card-content-rank-livab' style='height:100%;display:flex;flex-direction:column;align-items:center;text-align:center'>" &
			      
			      "<div style='font-size:42px;font-weight:700;color:#0066CC;line-height:1;margin-bottom:3px;margin-top:8px'>" &
			        "#<span class='rank-number-livab' data-target='" & FORMAT(CurrentRank, "0") & "'>0</span>" &
			      "</div>" &
			      
			      "<div style='font-size:11px;font-weight:500;color:#666666;margin-bottom:10px'>" &
			        "Livability Rank" &
			      "</div>" &
			      
			      "<div style='padding-top:8px;border-top:1px solid #f0f0f0;width:100%'>" &
			        "<div style='display:flex;justify-content:space-between;align-items:center;margin-bottom:6px'>" &
			          "<div style='font-size:9px;font-weight:600;color:#999999;text-transform:uppercase;letter-spacing:0.3px'>Last Year Rank</div>" &
			          "<div style='font-size:13px;font-weight:600;color:#333333'>" & 
			            IF(NOT(ISBLANK(PreviousYearRank)), "#" & FORMAT(PreviousYearRank, "0"), "N/A") & 
			          "</div>" &
			        "</div>" &
			        "<div style='display:flex;justify-content:space-between;align-items:center;gap:6px'>" &
			          "<div style='font-size:9px;font-weight:600;color:#999999;text-transform:uppercase;letter-spacing:0.3px;white-space:nowrap'>YoY</div>" &
			          "<div style='display:flex;align-items:baseline;gap:4px'>" &
			            "<div style='display:inline-block;padding:3px 8px;border-radius:12px;font-size:11px;font-weight:700;background:" & 
			              IF(RankChange > 0, "#E6F3FF", IF(RankChange < 0, "#FFE6E6", "#F5F5F5")) & 
			              ";color:" & 
			              IF(RankChange > 0, "#0066CC", IF(RankChange < 0, "#C75B5B", "#999999")) & 
			            "'>" & 
			              IF(
			                NOT(ISBLANK(RankChange)), 
			                IF(RankChange > 0, "↑" & FORMAT(RankChange, "0"), IF(RankChange < 0, "↓" & FORMAT(ABS(RankChange), "0"), "—")),
			                "N/A"
			              ) & 
			            "</div>" &
			            IF(
			              NOT(ISBLANK([YoY - Livability])) && [Avg Livability Score] <> 0,
			              "<span style='font-size:8px;color:#999999'>" & FORMAT([YoY - Livability] / [Avg Livability Score], "+0.0%;-0.0%;0%") & "</span>",
			              ""
			            ) &
			          "</div>" &
			        "</div>" &
			      "</div>" &
			    "</div>" &
			
			    "<div class='tooltip-overlay-rank-livab'>" &
			      "<div style='font-size:11px;font-weight:700;margin-bottom:8px;'>Rank Insights</div>" &
			      "<p style='font-size:9px;line-height:1.5;margin:0;font-weight:400;opacity:0.95'>" &
			        "Shows city position in Livability. Lower rank = better performance. Upward arrows indicate improved ranking." &
			      "</p>" &
			      "<div style='margin-top:8px;font-size:8px;opacity:0.85;line-height:1.4'>" &
			        "YoY tracks year-over-year change in the score value." &
			      "</div>" &
			    "</div>" &
			
			  "</div>" &
			  
			  // ✨ JAVASCRIPT PARA CONTADOR ANIMADO
			  "<script>" &
			    "(function() {" &
			      "const el = document.querySelector('.rank-number-livab');" &
			      "if (!el) return;" &
			      "const target = parseInt(el.getAttribute('data-target'));" &
			      "const duration = 1200;" & // 1.2 segundos
			      "const steps = 60;" &
			      "const increment = target / steps;" &
			      "let current = 0;" &
			      "let step = 0;" &
			      "const timer = setInterval(() => {" &
			        "step++;" &
			        "current = Math.min(Math.ceil(increment * step), target);" &
			        "el.textContent = current;" &
			        "if (current >= target) clearInterval(timer);" &
			      "}, duration / steps);" &
			    "})();" &
			  "</script>" &
			"</div>"
			```
		lineageTag: bb8a78f9-3f2b-4c65-83ad-57d165f816b5

