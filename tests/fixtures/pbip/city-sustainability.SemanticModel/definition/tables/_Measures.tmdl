	/// Dynamic chart title with intelligent insights
	measure 'Page 1 - Line Chart - Title' = ```
			
			VAR CityName = SELECTEDVALUE('City Lookup'[City], "All Cities")
			VAR MetricOrder = SELECTEDVALUE('Parameter'[Parameter Order])
			VAR MetricName = 
			    SWITCH(
			        MetricOrder,
			        0, "Livability Index",
			        1, "Housing Affordability",
			        2, "Transit Quality",
			        3, "Green Space",
			        4, "Emissions",
			        "Unknown Metric"
			    )
			VAR TrendValue = [Analysis - Trend Direction]
			VAR PctChange = [Analysis - Period Change %]
			
			VAR TitleText = 
			    CityName & " " & MetricName & " is " & 
			    SWITCH(
			        TrendValue,
			        "improving", "improving ↗",
			        "declining", "declining ↘",
			        "stable", "holding steady →"
			    ) & 
			    " (" & FORMAT(PctChange, "+0.0%;-0.0%") & " over 10 years)"
			
			RETURN
			TitleText
			
			```
		lineageTag: b0d1c624-07b0-4240-a970-86fc87d69882

	/// Dynamic subtitle with detailed insights
	measure 'Page 1 - Line Chart - Subtitle' = ```
			
			VAR PeakYr = [Analysis - Peak Year]
			VAR LowestYr = [Analysis - Lowest Year]
			VAR YearsAbove = [Analysis - Years Above Average]
			VAR CurrentGap = [Analysis - Current Gap vs Benchmark]
			VAR YoYChange = [Analysis - YoY Change]
			VAR YoYPct = [Analysis - YoY Change %]
			VAR DropYear = [Analysis - Biggest Drop Year]
			
			VAR MaxYear = MAX('City Metrics'[Year])
			VAR PrevYear = MaxYear - 1
			
			VAR YoYText = 
			    IF(
			        ABS(YoYChange) < 0.5,
			        "YoY (" & MaxYear & " vs " & PrevYear & "): Flat (" & FORMAT(YoYPct, "+0.0%;-0.0%") & ")",
			        "YoY (" & MaxYear & " vs " & PrevYear & "): " & FORMAT(YoYChange, "+0.0;-0.0") & " pts (" & FORMAT(YoYPct, "+0.0%;-0.0%") & ")"
			    )
			
			VAR PerformanceText = 
			    IF(
			        YearsAbove >= 7,
			        "outperformed avg " & YearsAbove & "/10 years",
			        IF(
			            YearsAbove <= 3,
			            "underperformed avg " & (10 - YearsAbove) & "/10 years",
			            "mixed performance (" & YearsAbove & "/10 years above avg)"
			        )
			    )
			
			VAR GapText = 
			    IF(
			        ABS(CurrentGap) < 1,
			        "at par with benchmark",
			        IF(
			            CurrentGap > 0,
			            FORMAT(CurrentGap, "+0.0") & " pts above benchmark",
			            FORMAT(ABS(CurrentGap), "0.0") & " pts below benchmark"
			        )
			    )
			
			
			VAR DropText = 
			    IF(
			        NOT(ISBLANK(DropYear)),
			        " • ⚠ Significant drop in " & DropYear,
			        ""
			    )
			
			VAR SubtitleText = 
			    YoYText & " • Peak: " & PeakYr & ", Low: " & LowestYr & " • " &
			    PerformanceText & " • " & GapText &
			    DropText
			
			RETURN
			SubtitleText
			
			```
		lineageTag: 635aaec1-9594-4706-9b15-e4575b8e1840

	/// Find year with biggest drop compared to previous year
	measure 'Analysis - Biggest Drop Year' = ```
			
			VAR YearlyChanges = 
			    ADDCOLUMNS(
			        FILTER(ALL('City Metrics'[Year]), 'City Metrics'[Year] > 2015),
			        "CurrentValue", [Selected City Metric],
			        "PreviousValue", 
			            CALCULATE(
			                [Selected City Metric],
			                'City Metrics'[Year] = EARLIER('City Metrics'[Year]) - 1
			            ),
			        "YearChange", 
			            [Selected City Metric] - 
			            CALCULATE(
			                [Selected City Metric],
			                'City Metrics'[Year] = EARLIER('City Metrics'[Year]) - 1
			            )
			    )
			
			VAR BiggestDrop = MINX(YearlyChanges, [YearChange])
			
			VAR DropYear = 
			    CALCULATE(
			        SELECTEDVALUE('City Metrics'[Year]),
			        FILTER(
			            YearlyChanges,
			            [YearChange] = BiggestDrop
			        )
			    )
			
			RETURN
			IF(BiggestDrop < -1, DropYear, BLANK())
			
			```
		formatString: 0
		lineageTag: bba9d011-e96a-429e-ad11-b7849e2c2b88

	/// Year over Year change - dynamic based on filter context
	measure 'Analysis - YoY Change' = ```
			
			VAR MaxYear = MAX('City Metrics'[Year])
			VAR PrevYear = MaxYear - 1
			
			VAR ValueCurrent = CALCULATE([Selected City Metric], 'City Metrics'[Year] = MaxYear)
			VAR ValuePrevious = CALCULATE([Selected City Metric], 'City Metrics'[Year] = PrevYear)
			VAR YoYChange = ValueCurrent - ValuePrevious
			
			RETURN
			YoYChange
			
			```
		formatString: 0.0
		lineageTag: 8b689aa4-45f1-488c-86fb-48886550de79

	/// Year over Year percentage change - dynamic based on filter context
	measure 'Analysis - YoY Change %' = ```
			
			VAR MaxYear = MAX('City Metrics'[Year])
			VAR PrevYear = MaxYear - 1
			
			VAR ValueCurrent = CALCULATE([Selected City Metric], 'City Metrics'[Year] = MaxYear)
			VAR ValuePrevious = CALCULATE([Selected City Metric], 'City Metrics'[Year] = PrevYear)
			VAR YoYPct = DIVIDE(ValueCurrent - ValuePrevious, ValuePrevious, 0)
			
			RETURN
			YoYPct
			
			```
		formatString: 0.0%
		lineageTag: 46bf76d1-1de2-43e6-ac4d-616aa6ffd85a

	/// Smart Y-axis range that focuses on data visibility
	measure 'Page 1 - Line Chart - Y Axis Max Smart' = ```
			
			VAR CityMin = MINX(ALL('City Metrics'[Year]), [Selected City Metric])
			VAR BenchmarkMin = MINX(ALL('City Metrics'[Year]), [All Cities Benchmark])
			VAR OverallMin = MIN(CityMin, BenchmarkMin)
			
			VAR CityMax = MAXX(ALL('City Metrics'[Year]), [Selected City Metric])
			VAR BenchmarkMax = MAXX(ALL('City Metrics'[Year]), [All Cities Benchmark])
			VAR OverallMax = MAX(CityMax, BenchmarkMax)
			
			VAR DataRange = OverallMax - OverallMin
			
			
			VAR PaddingPct = 
			    SWITCH(
			        TRUE(),
			        DataRange < 5, 0.15,     
			        DataRange < 10, 0.12,     
			        DataRange < 20, 0.10,     
			        0.08                      
			    )
			
			VAR Padding = DataRange * PaddingPct
			VAR AdjustedMin = OverallMin - Padding
			VAR AdjustedMax = OverallMax + Padding
			
			
			VAR RoundingFactor = 
			    SWITCH(
			        TRUE(),
			        DataRange < 10, 1,       
			        DataRange < 30, 2,       
			        5                        
			    )
			
			VAR SmartMin = FLOOR(AdjustedMin, RoundingFactor)
			VAR SmartMax = CEILING(AdjustedMax, RoundingFactor)
			
			RETURN
			SmartMax
			
			```
		formatString: 0.0
		lineageTag: af5046dc-665d-4f73-89b5-92ef933389d6

