	measure 'Analysis - Years Above Avg (Transit)' = ```
			
			VAR CitySelected = SELECTEDVALUE('City Lookup'[City])
			
			VAR YearsAbove = 
			    COUNTROWS(
			        FILTER(
			            VALUES('City Metrics'[Year]),
			            VAR CityScore = 
			                CALCULATE(
			                    [Avg Transit Score],
			                    'City Lookup'[City] = CitySelected
			                )
			            VAR GlobalAvg = 
			                CALCULATE(
			                    [Avg Transit Score],
			                    ALL('City Lookup'[City])
			                )
			            RETURN CityScore > GlobalAvg
			        )
			    )
			
			RETURN YearsAbove
			```
		formatString: 0
		lineageTag: e1ecaecb-22df-440e-8045-1eb79b8802aa

