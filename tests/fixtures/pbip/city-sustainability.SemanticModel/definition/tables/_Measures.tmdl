	measure 'Page 2 - City Performance Radar Elegant HTML' = ```
			
			VAR CurrentCity = SELECTEDVALUE('City Lookup'[City], "No City Selected")
			VAR SelectedYear = SELECTEDVALUE('City Metrics'[Year], 2024)
			
			
			VAR HousingScore = [Avg Housing Affordability]
			VAR TransitScore = [Avg Transit Score]
			VAR GreenScore = [Avg Green Space]
			VAR EmissionsScore = [Avg Emissions]
			VAR LivabilityScore = [Avg Livability Score]
			
			
			VAR AngleTransit = 270 * 3.14159 / 180
			VAR AngleLivability = 342 * 3.14159 / 180
			VAR AngleGreen = 54 * 3.14159 / 180
			VAR AngleHousing = 126 * 3.14159 / 180
			VAR AngleEmissions = 198 * 3.14159 / 180
			
			
			VAR CenterX = 250
			VAR CenterY = 250
			VAR MaxRadius = 180
			
			
			VAR OuterTransitX = CenterX + MaxRadius * COS(AngleTransit)
			VAR OuterTransitY = CenterY + MaxRadius * SIN(AngleTransit)
			VAR OuterLivabilityX = CenterX + MaxRadius * COS(AngleLivability)
			VAR OuterLivabilityY = CenterY + MaxRadius * SIN(AngleLivability)
			VAR OuterGreenX = CenterX + MaxRadius * COS(AngleGreen)
			VAR OuterGreenY = CenterY + MaxRadius * SIN(AngleGreen)
			VAR OuterHousingX = CenterX + MaxRadius * COS(AngleHousing)
			VAR OuterHousingY = CenterY + MaxRadius * SIN(AngleHousing)
			VAR OuterEmissionsX = CenterX + MaxRadius * COS(AngleEmissions)
			VAR OuterEmissionsY = CenterY + MaxRadius * SIN(AngleEmissions)
			
			
			VAR DataTransitX = CenterX + (MaxRadius * TransitScore / 100) * COS(AngleTransit)
			VAR DataTransitY = CenterY + (MaxRadius * TransitScore / 100) * SIN(AngleTransit)
			VAR DataLivabilityX = CenterX + (MaxRadius * LivabilityScore / 100) * COS(AngleLivability)
			VAR DataLivabilityY = CenterY + (MaxRadius * LivabilityScore / 100) * SIN(AngleLivability)
			VAR DataGreenX = CenterX + (MaxRadius * GreenScore / 100) * COS(AngleGreen)
			VAR DataGreenY = CenterY + (MaxRadius * GreenScore / 100) * SIN(AngleGreen)
			VAR DataHousingX = CenterX + (MaxRadius * HousingScore / 100) * COS(AngleHousing)
			VAR DataHousingY = CenterY + (MaxRadius * HousingScore / 100) * SIN(AngleHousing)
			VAR DataEmissionsX = CenterX + (MaxRadius * EmissionsScore / 100) * COS(AngleEmissions)
			VAR DataEmissionsY = CenterY + (MaxRadius * EmissionsScore / 100) * SIN(AngleEmissions)
			
			
			VAR LabelOffset = 210
			VAR LabelTransitX = CenterX + LabelOffset * COS(AngleTransit)
			VAR LabelTransitY = CenterY + LabelOffset * SIN(AngleTransit)
			VAR LabelLivabilityX = CenterX + LabelOffset * COS(AngleLivability)
			VAR LabelLivabilityY = CenterY + LabelOffset * SIN(AngleLivability)
			VAR LabelGreenX = CenterX + LabelOffset * COS(AngleGreen)
			VAR LabelGreenY = CenterY + LabelOffset * SIN(AngleGreen)
			VAR LabelHousingX = CenterX + LabelOffset * COS(AngleHousing)
			VAR LabelHousingY = CenterY + LabelOffset * SIN(AngleHousing)
			VAR LabelEmissionsX = CenterX + LabelOffset * COS(AngleEmissions)
			VAR LabelEmissionsY = CenterY + LabelOffset * SIN(AngleEmissions)
			
			
			VAR OuterPentagon = 
			    OuterTransitX & "," & OuterTransitY & " " &
			    OuterLivabilityX & "," & OuterLivabilityY & " " &
			    OuterGreenX & "," & OuterGreenY & " " &
			    OuterHousingX & "," & OuterHousingY & " " &
			    OuterEmissionsX & "," & OuterEmissionsY
			
			VAR DataPolygon = 
			    DataTransitX & "," & DataTransitY & " " &
			    DataLivabilityX & "," & DataLivabilityY & " " &
			    DataGreenX & "," & DataGreenY & " " &
			    DataHousingX & "," & DataHousingY & " " &
			    DataEmissionsX & "," & DataEmissionsY
			
			RETURN
			"<div style='font-family:Segoe UI,system-ui,sans-serif;background:transparent;padding:0px 10px 0px 10px;;height:95%;overflow:hidden;display:flex;align-items:center;justify-content:center;'>" &
			
			  "<!-- SVG Radar Chart -->" &
			  "<svg viewBox='0 0 500 500' style='max-width:100%;height:auto;'>" &
			    "<defs>" &
			      "<linearGradient id='radarGrad' x1='0%' y1='0%' x2='0%' y2='100%'>" &
			        "<stop offset='0%' style='stop-color:#0066CC;stop-opacity:0.4' />" &
			        "<stop offset='100%' style='stop-color:#0066CC;stop-opacity:0.1' />" &
			      "</linearGradient>" &
			      "<filter id='softGlow'>" &
			        "<feGaussianBlur stdDeviation='2' result='coloredBlur'/>" &
			        "<feMerge><feMergeNode in='coloredBlur'/><feMergeNode in='SourceGraphic'/></feMerge>" &
			      "</filter>" &
			    "</defs>" &
			    
			    "<!-- Grid circles -->" &
			    "<circle cx='" & CenterX & "' cy='" & CenterY & "' r='" & MaxRadius * 0.25 & "' fill='none' stroke='#e8e8e8' stroke-width='1' />" &
			    "<text x='" & CenterX & "' y='" & (CenterY - MaxRadius * 0.25 - 5) & "' text-anchor='middle' font-size='8' fill='#999999'>25%</text>" &
			    
			    "<circle cx='" & CenterX & "' cy='" & CenterY & "' r='" & MaxRadius * 0.5 & "' fill='none' stroke='#e0e0e0' stroke-width='1' />" &
			    "<text x='" & CenterX & "' y='" & (CenterY - MaxRadius * 0.5 - 5) & "' text-anchor='middle' font-size='8' fill='#999999'>50%</text>" &
			    
			    "<circle cx='" & CenterX & "' cy='" & CenterY & "' r='" & MaxRadius * 0.75 & "' fill='none' stroke='#d8d8d8' stroke-width='1' />" &
			    "<text x='" & CenterX & "' y='" & (CenterY - MaxRadius * 0.75 - 5) & "' text-anchor='middle' font-size='8' fill='#999999'>75%</text>" &
			    
			    "<circle cx='" & CenterX & "' cy='" & CenterY & "' r='" & MaxRadius & "' fill='none' stroke='#d0d0d0' stroke-width='1.5' />" &
			    "<text x='" & CenterX & "' y='" & (CenterY - MaxRadius - 5) & "' text-anchor='middle' font-size='8' font-weight='600' fill='#666666'>100%</text>" &
			    
			    "<!-- Reference lines -->" &
			    "<line x1='" & CenterX & "' y1='" & CenterY & "' x2='" & OuterTransitX & "' y2='" & OuterTransitY & "' stroke='#d8d8d8' stroke-width='1' />" &
			    "<line x1='" & CenterX & "' y1='" & CenterY & "' x2='" & OuterLivabilityX & "' y2='" & OuterLivabilityY & "' stroke='#d8d8d8' stroke-width='1' />" &
			    "<line x1='" & CenterX & "' y1='" & CenterY & "' x2='" & OuterGreenX & "' y2='" & OuterGreenY & "' stroke='#d8d8d8' stroke-width='1' />" &
			    "<line x1='" & CenterX & "' y1='" & CenterY & "' x2='" & OuterHousingX & "' y2='" & OuterHousingY & "' stroke='#d8d8d8' stroke-width='1' />" &
			    "<line x1='" & CenterX & "' y1='" & CenterY & "' x2='" & OuterEmissionsX & "' y2='" & OuterEmissionsY & "' stroke='#d8d8d8' stroke-width='1' />" &
			    
			    "<polygon points='" & OuterPentagon & "' fill='none' stroke='#c0c0c0' stroke-width='1.5' stroke-dasharray='4,3' />" &
			    
			    "<!-- Data polygon -->" &
			    "<polygon points='" & DataPolygon & "' fill='url(#radarGrad)' stroke='#0066CC' stroke-width='2.5' stroke-linejoin='round' filter='url(#softGlow)'>" &
			      "<animate attributeName='opacity' from='0' to='1' dur='0.8s' fill='freeze' />" &
			    "</polygon>" &
			    
			    "<!-- Data points -->" &
			    "<circle cx='" & DataTransitX & "' cy='" & DataTransitY & "' r='5' fill='#0066CC' stroke='white' stroke-width='2'><animate attributeName='r' from='0' to='5' dur='0.5s' begin='0.3s' fill='freeze' /></circle>" &
			    "<text x='" & DataTransitX & "' y='" & (DataTransitY - 12) & "' text-anchor='middle' font-size='10' font-weight='600' fill='#0066CC'>" & FORMAT(TransitScore, "0") & "%</text>" &
			    
			    "<circle cx='" & DataLivabilityX & "' cy='" & DataLivabilityY & "' r='5' fill='#0066CC' stroke='white' stroke-width='2'><animate attributeName='r' from='0' to='5' dur='0.5s' begin='0.4s' fill='freeze' /></circle>" &
			    "<text x='" & (DataLivabilityX + 14) & "' y='" & (DataLivabilityY + 4) & "' text-anchor='start' font-size='10' font-weight='600' fill='#0066CC'>" & FORMAT(LivabilityScore, "0") & "%</text>" &
			    
			    "<circle cx='" & DataGreenX & "' cy='" & DataGreenY & "' r='5' fill='#0066CC' stroke='white' stroke-width='2'><animate attributeName='r' from='0' to='5' dur='0.5s' begin='0.5s' fill='freeze' /></circle>" &
			    "<text x='" & (DataGreenX + 14) & "' y='" & (DataGreenY + 4) & "' text-anchor='start' font-size='10' font-weight='600' fill='#0066CC'>" & FORMAT(GreenScore, "0") & "%</text>" &
			    
			    "<circle cx='" & DataHousingX & "' cy='" & DataHousingY & "' r='5' fill='#0066CC' stroke='white' stroke-width='2'><animate attributeName='r' from='0' to='5' dur='0.5s' begin='0.6s' fill='freeze' /></circle>" &
			    "<text x='" & (DataHousingX - 14) & "' y='" & (DataHousingY + 4) & "' text-anchor='end' font-size='10' font-weight='600' fill='#0066CC'>" & FORMAT(HousingScore, "0") & "%</text>" &
			    
			    "<circle cx='" & DataEmissionsX & "' cy='" & DataEmissionsY & "' r='5' fill='#0066CC' stroke='white' stroke-width='2'><animate attributeName='r' from='0' to='5' dur='0.5s' begin='0.7s' fill='freeze' /></circle>" &
			    "<text x='" & (DataEmissionsX - 14) & "' y='" & (DataEmissionsY + 4) & "' text-anchor='end' font-size='10' font-weight='600' fill='#0066CC'>" & FORMAT(EmissionsScore, "0") & "%</text>" &
			    
			    "<!-- Labels -->" &
			    "<g transform='translate(" & LabelTransitX & "," & LabelTransitY & ")'>" &
			      "<text x='0' y='0' text-anchor='middle' font-size='12' font-weight='600' fill='#1a1a1a'>Transit</text>" &
			      "<text x='0' y='14' text-anchor='middle' font-size='9' font-weight='400' fill='#666666'>Quality</text>" &
			    "</g>" &
			    
			    "<g transform='translate(" & LabelLivabilityX & "," & LabelLivabilityY & ")'>" &
			      "<text x='0' y='0' text-anchor='start' font-size='12' font-weight='600' fill='#1a1a1a'>Livability</text>" &
			      "<text x='0' y='14' text-anchor='start' font-size='9' font-weight='400' fill='#666666'>Index</text>" &
			    "</g>" &
			    
			    "<g transform='translate(" & LabelGreenX & "," & LabelGreenY & ")'>" &
			      "<text x='0' y='0' text-anchor='start' font-size='12' font-weight='600' fill='#1a1a1a'>Green</text>" &
			      "<text x='0' y='14' text-anchor='start' font-size='9' font-weight='400' fill='#666666'>Space %</text>" &
			    "</g>" &
			    
			    "<g transform='translate(" & LabelHousingX & "," & LabelHousingY & ")'>" &
			      "<text x='0' y='0' text-anchor='end' font-size='12' font-weight='600' fill='#1a1a1a'>Housing</text>" &
			      "<text x='0' y='14' text-anchor='end' font-size='9' font-weight='400' fill='#666666'>Affordability</text>" &
			    "</g>" &
			    
			    "<g transform='translate(" & (LabelEmissionsX + 5) & "," & LabelEmissionsY & ")'>" &
			      "<text x='0' y='0' text-anchor='end' font-size='12' font-weight='600' fill='#1a1a1a'>Emissions</text>" &
			      "<text x='0' y='14' text-anchor='end' font-size='9' font-weight='400' fill='#666666'>Index</text>" &
			    "</g>" &
			    
			  "</svg>" &
			  
			"</div>"
			```
		lineageTag: 084cc207-3e25-4b9a-8ce2-ae2366d219b8

	measure '_Norm Housing Score' = ```
			// Normaliza Housing Affordability (invertido: menor é melhor)
			// Range: 24.58 a 53.39
			VAR CurrentValue = AVERAGE('City Metrics'[HousingAffordabilityIndex])
			VAR MinValue = 24.58
			VAR MaxValue = 53.39
			
			// Inverte a escala: quanto MENOR o housing index, MAIOR o score
			VAR NormalizedScore = 
			    DIVIDE(
			        MaxValue - CurrentValue,
			        MaxValue - MinValue,
			        0
			    ) * 100
			
			RETURN NormalizedScore
			```
		isHidden
		lineageTag: 8631d1fd-b90a-4a86-adcc-da2abcb6135b

