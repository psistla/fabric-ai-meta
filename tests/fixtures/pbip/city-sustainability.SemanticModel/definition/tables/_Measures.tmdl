	/// Calculate current gap vs benchmark
	measure 'Analysis - Current Gap vs Benchmark' = ```
			
			VAR CurrentValue = CALCULATE([Selected City Metric], 'City Metrics'[Year] = 2024)
			VAR BenchmarkValue = CALCULATE([All Cities Benchmark], 'City Metrics'[Year] = 2024)
			VAR Gap = CurrentValue - BenchmarkValue
			
