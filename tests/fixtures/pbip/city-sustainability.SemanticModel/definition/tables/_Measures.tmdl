	measure 'Alt Text - Emissions Line Chart' = ```
			VAR CityName = SELECTEDVALUE('City Lookup'[City], "All Cities")
			VAR TrendValue = [Analysis - Trend Direction (Emissions)]
			VAR PctChange = [Analysis - Period Change % (Emissions)]
			VAR CurrentValue = CALCULATE([Avg Emissions], 'City Metrics'[Year] = 2024)
			VAR PeakYear = [Analysis - Peak Year (Emissions)]
			VAR LowestYear = [Analysis - Lowest Year (Emissions)]
			VAR BenchmarkValue = [Page 2 - Avg Global Emissions (All Cities)]
			
			
			VAR TrendInterpretation = 
			    SWITCH(
			        TrendValue,
			        "improving", "declining (reducing emissions)",
			        "declining", "increasing (rising emissions)",
			        "stable"
			    )
			
			VAR AltText = 
			    "Line chart showing Emissions trends for " & CityName & " from 2015 to 2024. " &
			    "The trend is " & TrendInterpretation & " with " & FORMAT(ABS(PctChange), "0.0%") & " change over the period. " &
			    "Current 2024 value is " & FORMAT(CurrentValue, "0.0") & " (lower values indicate better environmental performance). " &
			    "Best emissions year: " & PeakYear & ", Worst emissions year: " & LowestYear & ". " &
			    "Horizontal benchmark line shows all cities average at " & FORMAT(BenchmarkValue, "0.0") & "."
			
			RETURN
			AltText
			```
		lineageTag: 7029a38d-4607-48c5-aa90-5e97ed48c5e3

	measure 'Analysis - Peak Year (Livability)' = ```
			VAR YearlyScores = 
			    ADDCOLUMNS(
			        VALUES('City Metrics'[Year]),
			        "@Score", [Avg Livability Score]
			    )
			
			VAR Result = 
			    MAXX(
			        TOPN(1, YearlyScores, [@Score], DESC),
			        'City Metrics'[Year]
			    )
			
			RETURN
			Result
			```
		lineageTag: ccba449e-3580-48b3-b61f-aa56bf358c5e

