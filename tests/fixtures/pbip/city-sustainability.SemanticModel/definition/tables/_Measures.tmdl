	measure 'Analysis - Trend Direction (Emissions)' = ```
			
			VAR FirstYear = MIN('City Metrics'[Year])
			VAR LastYear = MAX('City Metrics'[Year])
			
			VAR FirstValue = 
			    CALCULATE(
			        [Avg Emissions],
			        'City Metrics'[Year] = FirstYear
			    )
			    
			VAR LastValue = 
			    CALCULATE(
			        [Avg Emissions],
			        'City Metrics'[Year] = LastYear
			    )
			
			VAR PctChange = DIVIDE(LastValue - FirstValue, FirstValue, 0)
			
			
			RETURN
			    SWITCH(
			        TRUE(),
			        PctChange <= -0.05, "improving",  
			        PctChange >= 0.05, "declining",   
			        "stable"
			    )
			```
		lineageTag: 5aa705b6-421c-408a-a685-ec20fc9069f0

	measure 'Page 2 - Overall Performance Card HTML' = ```
			
			VAR LivChange = [Analysis - Period Change % (Livability)]
			VAR HousChange = [Analysis - Period Change % (Housing)]
			VAR TransChange = [Analysis - Period Change % (Transit)]
			VAR GreenChange = [Analysis - Period Change % (Green Space)]
			VAR EmissChange = [Analysis - Period Change % (Emissions)]
			
			
			VAR OverallScore = 
			    (LivChange * 0.3 + 
			     (HousChange * -1) * 0.2 + 
			     TransChange * 0.2 + 
			     GreenChange * 0.15 + 
			     (EmissChange * -1) * 0.15)
			
			
			VAR MetricsImproving = 
			    (IF([Analysis - Trend Direction (Livability)] = "improving", 1, 0) +
			     IF([Analysis - Trend Direction (Housing)] = "improving", 1, 0) +
			     IF([Analysis - Trend Direction (Transit)] = "improving", 1, 0) +
			     IF([Analysis - Trend Direction (Green Space)] = "improving", 1, 0) +
			     IF([Analysis - Trend Direction (Emissions)] = "improving", 1, 0))
			
			
			VAR LivChangeDisplay = LivChange
			VAR HousChangeDisplay = HousChange * -1
			VAR TransChangeDisplay = TransChange
			VAR GreenChangeDisplay = GreenChange
			VAR EmissChangeDisplay = EmissChange * -1
			
			
			VAR MaxChange = MAX(MAX(MAX(MAX(LivChangeDisplay, HousChangeDisplay), TransChangeDisplay), GreenChangeDisplay), EmissChangeDisplay)
			VAR BestMetric = 
			    SWITCH(
			        TRUE(),
			        LivChangeDisplay = MaxChange, "Livability",
			        HousChangeDisplay = MaxChange, "Housing",
			        TransChangeDisplay = MaxChange, "Transit",
			        GreenChangeDisplay = MaxChange, "Green Space",
			        "Emissions"
			    )
			
			
			VAR MinChange = MIN(MIN(MIN(MIN(LivChangeDisplay, HousChangeDisplay), TransChangeDisplay), GreenChangeDisplay), EmissChangeDisplay)
			VAR WorstMetric = 
			    SWITCH(
			        TRUE(),
			        LivChangeDisplay = MinChange, "Livability",
			        HousChangeDisplay = MinChange, "Housing",
			        TransChangeDisplay = MinChange, "Transit",
			        GreenChangeDisplay = MinChange, "Green Space",
			        "Emissions"
			    )
			
			
			VAR BestValue = 
			    SWITCH(
			        BestMetric,
			        "Livability", LivChange,
			        "Housing", HousChange,
			        "Transit", TransChange,
			        "Green Space", GreenChange,
			        EmissChange
			    )
			
			VAR WorstValue = 
			    SWITCH(
			        WorstMetric,
			        "Livability", LivChange,
			        "Housing", HousChange,
			        "Transit", TransChange,
			        "Green Space", GreenChange,
			        EmissChange
			    )
			
			
			VAR ColorPositive = "#4A9B9B"
			VAR ColorNegative = "#C75B5B"
			
			
			VAR TrendArrow = 
			    IF(OverallScore >= 0,
			        "<svg width='20' height='20' viewBox='0 0 24 24' fill='none' style='display:inline-block;vertical-align:middle;margin-left:6px;'>" &
			            "<path d='M7 17L17 7M17 7H9M17 7V15' stroke='" & ColorPositive & "' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'>" &
			                "<animate attributeName='opacity' values='1;0.7;1' dur='2s' repeatCount='indefinite' />" &
			            "</path>" &
			        "</svg>",
			        "<svg width='20' height='20' viewBox='0 0 24 24' fill='none' style='display:inline-block;vertical-align:middle;margin-left:6px;'>" &
			            "<path d='M17 7L7 17M7 17H15M7 17V9' stroke='" & ColorNegative & "' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'>" &
			                "<animate attributeName='opacity' values='1;0.7;1' dur='2s' repeatCount='indefinite' />" &
			            "</path>" &
			        "</svg>"
			    )
			
			RETURN
			"<div style='
			    font-family:system-ui,sans-serif;
			    background:transparent;
			    padding:20px;
			    position:absolute;
			    top:0;
			    left:0;
			    right:0;
			    bottom:0;
			    width:100%;
			    height:100%;
			    box-sizing:border-box;
			    overflow:hidden;
			'>" &
			
			  "<style>" &
			    ".overall-content { transition: all 0.5s cubic-bezier(0.165, 0.84, 0.44, 1); }" &
			    ".overall-container:hover .overall-content { transform: translateX(-100%); opacity: 0; }" &
			    ".overall-tooltip { " &
			        "position: absolute; top: 0; left: 100%; width: 100%; height: 100%; " &
			        "background: transparent; color: #1a1a1a; padding: 20px; " &
			        "transition: all 0.5s cubic-bezier(0.165, 0.84, 0.44, 1); " &
			        "display: flex; flex-direction: column; justify-content: center; box-sizing: border-box; opacity: 0;" &
			    "}" &
			    ".overall-container:hover .overall-tooltip { transform: translateX(-100%); opacity: 1; }" &
			  "</style>" &
			
			  "<div class='overall-container' style='position:relative;width:100%;height:100%;overflow:hidden;cursor:pointer;'>" &
			    
			    
			    "<div class='overall-content' style='height:100%;display:flex;align-items:center;justify-content:space-between;'>" &
			      
			     
			      "<div style='flex:0 0 35%;'>" &
			        
			        "<div style='font-size:36px;font-weight:700;color:" & IF(OverallScore >= 0, ColorPositive, ColorNegative) & ";line-height:1;margin-bottom:8px;display:flex;align-items:center;'>" &
			          FORMAT(OverallScore, "+0.0%;-0.0%") & TrendArrow &
			        "</div>" &
			        
			        "<div style='font-size:11px;font-weight:500;color:#666666;margin-top:10px;margin-bottom:3px'>" &
			          "Overall Performance" &
			        "</div>" &
			        
			        "<div style='font-size:9px;font-weight:400;color:#999999'>" &
			          MetricsImproving & " of 5 metrics improving" &
			        "</div>" &
			      "</div>" &
			      
			      
			      "<div style='flex:0 0 60%;margin-top:10px;padding-left:20px;border-left:1px solid #f0f0f0'>" &
			        
			       
			        "<div style='margin-bottom:12px;padding-bottom:12px;border-bottom:1px solid #f0f0f0'>" &
			          "<div style='display:flex;justify-content:space-between;align-items:center'>" &
			            "<div>" &
			              "<div style='font-size:9px;font-weight:600;color:#4A9B9B;text-transform:uppercase;margin-bottom:2px'>Strongest Performer</div>" &
			              "<div style='font-size:12px;font-weight:600;color:#333333'>" & BestMetric & "</div>" &
			            "</div>" &
			            "<div style='font-size:16px;font-weight:700;color:#4A9B9B'>" & FORMAT(BestValue, "+0.0%;-0.0%") & "</div>" &
			          "</div>" &
			        "</div>" &
			        
			       
			        "<div>" &
			          "<div style='display:flex;justify-content:space-between;align-items:center'>" &
			            "<div>" &
			              "<div style='font-size:9px;font-weight:600;color:#C75B5B;text-transform:uppercase;margin-bottom:2px'>Needs Attention</div>" &
			              "<div style='font-size:12px;font-weight:600;color:#333333'>" & WorstMetric & "</div>" &
			            "</div>" &
			            "<div style='font-size:16px;font-weight:700;color:#C75B5B'>" & FORMAT(WorstValue, "+0.0%;-0.0%") & "</div>" &
			          "</div>" &
			        "</div>" &
			        
			      "</div>" &
			      
			    "</div>" &
			
			    
			    "<div class='overall-tooltip'>" &
			      "<div style='font-size:11px;font-weight:700;margin-bottom:6px;color:#1a1a1a;'>Quick Guide</div>" &
			      "<div style='font-size:9px;line-height:1.4;color:#666666;'>" &
			        "Composite score tracking city progress across 5 dimensions (2015-2024).<br><br>" &
			        "<strong style='color:#333333;'>Weights:</strong> Livability 30% • Housing & Transit 20% • Green Space & Emissions 15%<br><br>" &
			        "Compare strongest vs weakest areas to prioritize strategic improvements." &
			      "</div>" &
			    "</div>" &
			
			  "</div>" &
			"</div>"
			
			```
		lineageTag: 154deb00-e5ec-4aad-bc38-d2966d15f92c

