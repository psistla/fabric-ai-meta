	/// Public image URLs for metric icons - alternative to SVG inline
	measure 'Field Parameter - Icon URL' = ```
			
			
			// Free to use, no attribution required in most cases
			
			VAR _livability_photo = "https://pub-ae61e2e039ab4ff99bddfbd577e1ad75.r2.dev/modern-city-skyline-silhouette-at-blue-h_Z23tigWaTPO7I6PBrwkYbQ_we3aANIpQ8a28C-QnABc7w%20(1).png"
			
			
			VAR _housing_photo = "https://pub-ae61e2e039ab4ff99bddfbd577e1ad75.r2.dev/residential-neighborhood-rooftops-at-blu_eXM-ycaRT4KKaD2IDK-7Dw_h8H49YvORbuobMkqHV41zw%20(1).png"
			
			
			VAR _transit_photo = "https://pub-ae61e2e039ab4ff99bddfbd577e1ad75.r2.dev/modern-transit-bus-or-train-in-twilight-_YMQ8Ij3lQmumNxU5nE_xrg_NpO_hW1sQ96OBRMxGFGvHw%20(1).png"
			
			
			VAR _greenspace_photo = "https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=400&q=80"
			
			
			VAR _emissions_photo = "https://pub-ae61e2e039ab4ff99bddfbd577e1ad75.r2.dev/industrial-smokestacks-with-soft-steam-a_t1wezITGQySc6L6vXGhRQg_yuwFaQ5zQoOmLVd9OYNw_g%20(1).png"
			
			
			RETURN
			SWITCH(
