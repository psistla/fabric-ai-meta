	measure 'Subtitle - Livability' = ```
			VAR CidadeSelecionada = SELECTEDVALUE('City Lookup'[City])
			VAR ValorCidade = [Avg Livability Score]
			VAR MediaGeral = CALCULATE([Avg Livability Score], ALL('City Lookup'[City]))
			VAR DiferencaMedia = ValorCidade - MediaGeral
			VAR AcimaMedia = DiferencaMedia >= 0
			
			RETURN
			IF(
			    NOT(ISBLANK(CidadeSelecionada)),
			    CidadeSelecionada & " is " & 
			    FORMAT(ABS(DiferencaMedia), "0.0") & " points " &
			    IF(AcimaMedia, "above", "below") & " average",
			    "Select a city to compare"
			)
			```
		lineageTag: b3842cd4-ca60-4ad4-b26a-92fd38e6445a

	measure 'Subtitle - Housing' = ```
			VAR CidadeSelecionada = SELECTEDVALUE('City Lookup'[City])
			VAR ValorCidade = [Avg Housing Affordability]
			VAR MediaGeral = CALCULATE([Avg Housing Affordability], ALL('City Lookup'[City]))
			VAR DiferencaMedia = ValorCidade - MediaGeral
			VAR AcimaMedia = DiferencaMedia <= 0
			
			RETURN
			IF(
			    NOT(ISBLANK(CidadeSelecionada)),
			    CidadeSelecionada & " is " & 
			    FORMAT(ABS(DiferencaMedia), "0.0") & " points " &
			    IF(AcimaMedia, "more affordable", "less affordable") & " than average",
			    "Select a city to compare"
			)
