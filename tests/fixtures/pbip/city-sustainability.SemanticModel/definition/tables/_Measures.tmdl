	measure 'Page 4 - 10-Year Insights Panel' = ```
			
			VAR CurrentCity = SELECTEDVALUE('City Lookup'[City], "All Cities")
			VAR StartYear = 2015
			VAR EndYear = 2024
			
			
			VAR LivabilityStart = CALCULATE([Avg Livability Score], 'City Metrics'[Year] = StartYear)
			VAR LivabilityEnd = CALCULATE([Avg Livability Score], 'City Metrics'[Year] = EndYear)
			VAR LivabilityChange = LivabilityEnd - LivabilityStart
			
			VAR HousingStart = CALCULATE([Avg Housing Affordability], 'City Metrics'[Year] = StartYear)
			VAR HousingEnd = CALCULATE([Avg Housing Affordability], 'City Metrics'[Year] = EndYear)
			VAR HousingChange = HousingEnd - HousingStart
			
			VAR TransitStart = CALCULATE([Avg Transit Score], 'City Metrics'[Year] = StartYear)
			VAR TransitEnd = CALCULATE([Avg Transit Score], 'City Metrics'[Year] = EndYear)
			VAR TransitChange = TransitEnd - TransitStart
			
			VAR GreenStart = CALCULATE([Avg Green Space], 'City Metrics'[Year] = StartYear)
			VAR GreenEnd = CALCULATE([Avg Green Space], 'City Metrics'[Year] = EndYear)
			VAR GreenChange = GreenEnd - GreenStart
			
			VAR EmissionsStart = CALCULATE([Avg Emissions], 'City Metrics'[Year] = StartYear)
			VAR EmissionsEnd = CALCULATE([Avg Emissions], 'City Metrics'[Year] = EndYear)
			VAR EmissionsChange = EmissionsEnd - EmissionsStart
			
			VAR MaxChange = MAX(ABS(LivabilityChange), MAX(ABS(HousingChange), MAX(ABS(TransitChange), MAX(ABS(GreenChange), ABS(EmissionsChange)))))
			VAR BiggestTransformer = 
			    SWITCH(
			        TRUE(),
			        ABS(LivabilityChange) = MaxChange, "Livability",
			        ABS(HousingChange) = MaxChange, "Housing",
			        ABS(TransitChange) = MaxChange, "Transit",
			        ABS(GreenChange) = MaxChange, "Green Space",
			        ABS(EmissionsChange) = MaxChange, "Emissions",
			        "None"
			    )
			VAR BiggestTransformerValue = 
			    SWITCH(
			        TRUE(),
			        ABS(LivabilityChange) = MaxChange, LivabilityChange,
			        ABS(HousingChange) = MaxChange, HousingChange,
			        ABS(TransitChange) = MaxChange, TransitChange,
			        ABS(GreenChange) = MaxChange, GreenChange,
			        ABS(EmissionsChange) = MaxChange, EmissionsChange,
			        0
			    )
			
			VAR IsGoodChange = 
			    SWITCH(
			        TRUE(),
			        BiggestTransformer = "Housing" && BiggestTransformerValue < 0, TRUE(),
			        BiggestTransformer = "Emissions" && BiggestTransformerValue < 0, TRUE(),
			        BiggestTransformer = "Housing" && BiggestTransformerValue >= 0, FALSE(),
			        BiggestTransformer = "Emissions" && BiggestTransformerValue >= 0, FALSE(),
			        BiggestTransformerValue >= 0, TRUE(),
			        FALSE()
			    )
			
			VAR AlertColor = IF(IsGoodChange, "#66B2FF", "#FFB74D")
			VAR AlertLabel = IF(IsGoodChange, "Progress", "Concern")
			
			
			VAR BaselineStart = (LivabilityStart + HousingStart + TransitStart + GreenStart + EmissionsStart) / 5
			VAR BaselineEnd = (LivabilityEnd + HousingEnd + TransitEnd + GreenEnd + EmissionsEnd) / 5
			VAR BaselineChange = BaselineEnd - BaselineStart
			
			
			VAR LivabilityRange = CALCULATE(MAXX(ALL('City Metrics'[Year]), [Avg Livability Score])) - CALCULATE(MINX(ALL('City Metrics'[Year]), [Avg Livability Score]))
			VAR HousingRange = CALCULATE(MAXX(ALL('City Metrics'[Year]), [Avg Housing Affordability])) - CALCULATE(MINX(ALL('City Metrics'[Year]), [Avg Housing Affordability]))
			VAR TransitRange = CALCULATE(MAXX(ALL('City Metrics'[Year]), [Avg Transit Score])) - CALCULATE(MINX(ALL('City Metrics'[Year]), [Avg Transit Score]))
			VAR GreenRange = CALCULATE(MAXX(ALL('City Metrics'[Year]), [Avg Green Space])) - CALCULATE(MINX(ALL('City Metrics'[Year]), [Avg Green Space]))
			VAR EmissionsRange = CALCULATE(MAXX(ALL('City Metrics'[Year]), [Avg Emissions])) - CALCULATE(MINX(ALL('City Metrics'[Year]), [Avg Emissions]))
			
			VAR MaxRange = MAX(LivabilityRange, MAX(HousingRange, MAX(TransitRange, MAX(GreenRange, EmissionsRange))))
			VAR MostVolatile = 
			    SWITCH(
			        TRUE(),
			        LivabilityRange = MaxRange, "Livability",
			        HousingRange = MaxRange, "Housing",
			        TransitRange = MaxRange, "Transit",
			        GreenRange = MaxRange, "Green Space",
			        EmissionsRange = MaxRange, "Emissions",
			        "None"
			    )
			
			// Alert logic
			VAR HasAlert1 = ABS(BiggestTransformerValue) > 5  // Significant 10-year change
			VAR HasAlert2 = ABS(BaselineChange) > 2  // Overall baseline movement over 10 years
			VAR HasAlert3 = MaxRange > 8  // High volatility detected
			VAR TotalAlerts = IF(HasAlert1, 1, 0) + IF(HasAlert2, 1, 0) + IF(HasAlert3, 1, 0)
			
			RETURN
			IF(
			    TotalAlerts = 0,
			    "No long-term insights available",
			    
			"<style>" &
			  "body,html{overflow:hidden!important;margin:0;padding:0;height:100%}" &
			  "*{overflow:hidden!important;scrollbar-width:none!important;box-sizing:border-box}" &
			  "::-webkit-scrollbar{display:none!important;width:0!important;height:0!important}" &
			  "@keyframes slideInRight{from{transform:translateX(30px);opacity:0}to{transform:translateX(0);opacity:1}}" &
			  ".notification-card{animation:slideInRight 0.5s ease-out forwards;opacity:0}" &
			  ".notification-card:nth-child(1){animation-delay:0.1s}" &
			  ".notification-card:nth-child(2){animation-delay:0.3s}" &
			  ".notification-card:nth-child(3){animation-delay:0.5s}" &
			  ".notification-card:nth-child(4){animation-delay:0.7s}" &
			"</style>" &
			
			"<div style='font-family:system-ui,sans-serif;padding:0;background:linear-gradient(180deg, #0F1C2E 0%, #1A2942 50%, #0A1628 100%);height:720px;width:280px;display:flex;flex-direction:column;overflow:hidden!important;margin:0;box-shadow:inset 0 1px 0 rgba(255,255,255,0.05)'>" &
			
			  "<!-- Header -->" &
			  "<div style='padding:18px 20px 14px;border-bottom:1px solid rgba(255,255,255,0.1)'>" &
			    "<div style='font-size:19px;font-weight:700;color:#FFFFFF;margin-bottom:5px;letter-spacing:-0.03em'>Notifications</div>" &
			    "<div style='display:flex;align-items:center;gap:8px'>" &
			      "<div style='font-size:11px;color:rgba(255,255,255,0.65);font-weight:400'>" & CurrentCity & " • " & StartYear & "-" & EndYear & "</div>" &
			      "<div style='display:inline-block;background:#0066CC;color:white;padding:2px 8px;border-radius:10px;font-size:10px;font-weight:600;box-shadow:0 2px 4px rgba(0,102,204,0.3)'>" & TotalAlerts & " trend" & IF(TotalAlerts > 1, "s", "") & "</div>" &
			    "</div>" &
			  "</div>" &
			
			  "<!-- Cards -->" &
			  "<div style='padding:16px 20px;flex:1;overflow:hidden;display:flex;flex-direction:column;gap:10px'>" &
			    
			    "<!-- Alert 1: Biggest 10-Year Transformation -->" &
			    IF(HasAlert1, 
			      "<div class='notification-card' style='background:rgba(10,22,40,0.6);border-left:3px solid " & AlertColor & ";border-radius:8px;padding:12px;backdrop-filter:blur(10px);border:1px solid " & IF(IsGoodChange, "rgba(102,178,255,0.15)", "rgba(255,183,77,0.15)") & "'>" &
			        "<div style='display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:7px'>" &
			          "<div style='display:flex;align-items:center;gap:6px'>" &
			            "<svg width='13' height='13' viewBox='0 0 24 24' fill='none' stroke='" & AlertColor & "' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><polyline points='23 6 13.5 15.5 8.5 10.5 1 18'/><polyline points='17 6 23 6 23 12'/></svg>" &
			            "<div style='font-size:9px;font-weight:600;color:" & AlertColor & ";text-transform:uppercase;letter-spacing:0.05em'>" & AlertLabel & "</div>" &
			          "</div>" &
			          "<div style='font-size:8px;color:rgba(255,255,255,0.4)'>Decade</div>" &
			        "</div>" &
			        "<div style='font-size:12px;font-weight:600;color:#FFFFFF;margin-bottom:5px'>" & BiggestTransformer & " Transformed</div>" &
			        "<div style='font-size:10px;color:rgba(255,255,255,0.65);line-height:1.4'>" & 
			          IF(
			            BiggestTransformer = "Housing" || BiggestTransformer = "Emissions",
			            IF(BiggestTransformerValue < 0, "Improved ", "Worsened "),
			            IF(BiggestTransformerValue >= 0, "Improved ", "Declined ")
			          ) & 
			          "<span style='font-weight:600;color:" & AlertColor & "'>" & FORMAT(ABS(BiggestTransformerValue), "0.0") & " pts</span> " &
			          "from " & StartYear & " to " & EndYear & "." &
			        "</div>" &
			      "</div>", 
			      ""
			    ) &
			    
			    "<!-- Alert 2: Overall 10-Year Baseline Trend -->" &
			    IF(HasAlert2,
			      "<div class='notification-card' style='background:rgba(10,22,40,0.6);border-left:3px solid " & IF(BaselineChange >= 0, "#66B2FF", "#FF6B6B") & ";border-radius:8px;padding:12px;backdrop-filter:blur(10px);border:1px solid " & IF(BaselineChange >= 0, "rgba(102,178,255,0.15)", "rgba(255,107,107,0.15)") & "'>" &
			        "<div style='display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:7px'>" &
			          "<div style='display:flex;align-items:center;gap:6px'>" &
			            "<svg width='13' height='13' viewBox='0 0 24 24' fill='none' stroke='" & IF(BaselineChange >= 0, "#66B2FF", "#FF6B6B") & "' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><polygon points='12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2'></polygon></svg>" &
			            "<div style='font-size:9px;font-weight:600;color:" & IF(BaselineChange >= 0, "#66B2FF", "#FF6B6B") & ";text-transform:uppercase;letter-spacing:0.05em'>Baseline</div>" &
			          "</div>" &
			          "<div style='font-size:8px;color:rgba(255,255,255,0.4)'>10-Yr</div>" &
			        "</div>" &
			        "<div style='font-size:12px;font-weight:600;color:#FFFFFF;margin-bottom:5px'>Long-Term " & IF(BaselineChange >= 0, "Growth", "Decline") & "</div>" &
			        "<div style='font-size:10px;color:rgba(255,255,255,0.65);line-height:1.4'>" &
			          "Overall baseline " & IF(BaselineChange >= 0, "rose", "fell") & " " &
			          "<span style='font-weight:600;color:" & IF(BaselineChange >= 0, "#66B2FF", "#FF6B6B") & "'>" & FORMAT(ABS(BaselineChange), "0.0") & " pts</span> over the decade." &
			        "</div>" &
			      "</div>",
			      ""
			    ) &
			    
			    "<!-- Alert 3: Most Volatile Dimension -->" &
			    IF(HasAlert3,
			      "<div class='notification-card' style='background:rgba(10,22,40,0.6);border-left:3px solid #FFB74D;border-radius:8px;padding:12px;backdrop-filter:blur(10px);border:1px solid rgba(255,183,77,0.15)'>" &
			        "<div style='display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:7px'>" &
			          "<div style='display:flex;align-items:center;gap:6px'>" &
			            "<svg width='13' height='13' viewBox='0 0 24 24' fill='none' stroke='#FFB74D' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z'/><line x1='12' y1='9' x2='12' y2='13'/><line x1='12' y1='17' x2='12.01' y2='17'/></svg>" &
			            "<div style='font-size:9px;font-weight:600;color:#FFB74D;text-transform:uppercase;letter-spacing:0.05em'>Volatility</div>" &
			          "</div>" &
			          "<div style='font-size:8px;color:rgba(255,255,255,0.4)'>Range</div>" &
			        "</div>" &
			        "<div style='font-size:12px;font-weight:600;color:#FFFFFF;margin-bottom:5px'>" & MostVolatile & " Fluctuated</div>" &
			        "<div style='font-size:10px;color:rgba(255,255,255,0.65);line-height:1.4'>" &
			          "Highest variance with <span style='font-weight:600;color:#FFB74D'>" & FORMAT(MaxRange, "0.0") & " pt range</span>. " &
			          "Requires stability interventions." &
			        "</div>" &
			      "</div>",
			      ""
			    ) &
			
			    "<!-- Strategic Summary Card -->" &
			    "<div class='notification-card' style='background:rgba(255,255,255,0.95);border-left:3px solid #0066CC;border-radius:8px;padding:12px;border:1px solid rgba(255,255,255,0.2);margin-top:auto'>" &
			      "<div style='display:flex;align-items:center;gap:6px;margin-bottom:7px'>" &
			        "<svg width='13' height='13' viewBox='0 0 24 24' fill='none' stroke='#0066CC' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z'/><polyline points='14 2 14 8 20 8'/><line x1='16' y1='13' x2='8' y2='13'/><line x1='16' y1='17' x2='8' y2='17'/><polyline points='10 9 9 9 8 9'/></svg>" &
			        "<div style='font-size:9px;font-weight:600;color:#0066CC;text-transform:uppercase;letter-spacing:0.05em'>Summary</div>" &
			      "</div>" &
			      "<div style='font-size:12px;font-weight:600;color:#0A1628;margin-bottom:5px'>Decade Performance</div>" &
			      "<div style='font-size:10px;color:#3A4A5A;line-height:1.4'>" &
			        "Overall baseline shifted <span style='font-weight:600;color:#0066CC'>" & FORMAT(BaselineChange, "+0.0;-0.0") & " pts</span>. " &
			        "Track volatility in " & MostVolatile & " for strategic planning." &
			      "</div>" &
			    "</div>" &
			    
			  "</div>" &
			"</div>"
			)
			```
		lineageTag: 35353fd4-8a1e-46bd-96ff-fb95596b0231

	measure 'Alt Text - Livability Line Chart' = ```
			VAR CityName = SELECTEDVALUE('City Lookup'[City], "All Cities")
			VAR TrendValue = [Analysis - Trend Direction (Livability)]
			VAR PctChange = [Analysis - Period Change % (Livability)]
			VAR CurrentValue = CALCULATE([Avg Livability Score], 'City Metrics'[Year] = 2024)
			VAR PeakYear = [Analysis - Peak Year (Livability)]
			VAR LowestYear = [Analysis - Lowest Year (Livability)]
			VAR BenchmarkValue = [Page 2 - Avg Global (All Cities)]
			
			VAR AltText = 
			    "Line chart showing Livability Index trends for " & CityName & " from 2015 to 2024. " &
			    "The trend is " & TrendValue & " with " & FORMAT(ABS(PctChange), "0.0%") & " change over the period. " &
			    "Current 2024 value is " & FORMAT(CurrentValue, "0.0") & ". " &
			    "Peak year: " & PeakYear & ", Lowest year: " & LowestYear & ". " &
			    "Horizontal benchmark line shows all cities average at " & FORMAT(BenchmarkValue, "0.0") & "."
			
			RETURN
			AltText
			```
		lineageTag: fa2fb658-929c-4697-9e9d-310f5007b5a4

	measure 'Alt Text - Housing Line Chart' = ```
			VAR CityName = SELECTEDVALUE('City Lookup'[City], "All Cities")
			VAR TrendValue = [Analysis - Trend Direction (Housing)]
			VAR PctChange = [Analysis - Period Change % (Housing)]
			VAR CurrentValue = CALCULATE([Avg Housing Affordability], 'City Metrics'[Year] = 2024)
			VAR PeakYear = [Analysis - Peak Year (Housing)]
			VAR LowestYear = [Analysis - Lowest Year (Housing)]
			VAR BenchmarkValue = [Page 2 - Avg Global Housing Affordability (All Cities)]
			
			
			VAR TrendInterpretation = 
			    SWITCH(
			        TrendValue,
			        "improving", "declining (improving affordability)",
			        "declining", "increasing (declining affordability)",
			        "stable"
			    )
			
			VAR AltText = 
			    "Line chart showing Housing Affordability trends for " & CityName & " from 2015 to 2024. " &
			    "The trend is " & TrendInterpretation & " with " & FORMAT(ABS(PctChange), "0.0%") & " change over the period. " &
			    "Current 2024 value is " & FORMAT(CurrentValue, "0.0") & " (lower values indicate better affordability). " &
			    "Best affordability year: " & PeakYear & ", Worst affordability year: " & LowestYear & ". " &
			    "Horizontal benchmark line shows all cities average at " & FORMAT(BenchmarkValue, "0.0") & "."
			
			RETURN
			AltText
			```
		lineageTag: d631841d-7d5d-4922-80da-b3c238d23754

