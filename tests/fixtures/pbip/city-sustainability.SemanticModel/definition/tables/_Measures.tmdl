			        SELECTEDVALUE('City Lookup'[City]),
			        TOPN(1, ALL('City Lookup'[City]), [Avg Housing Affordability], ASC)
			    )
			VAR TopScore = 
			    CALCULATE([Avg Housing Affordability], 'City Lookup'[City] = TopCity)
			
			VAR AltText = 
			    "Bar chart and ranking card for Housing Affordability dimension. " &
			    "The bar chart displays all " & TotalCities & " cities ranked by their " & SelectedYear & " housing affordability scores, with " & CurrentCity & " highlighted in blue at position #" & CurrentRank & " with a score of " & FORMAT(CurrentValue, "0.0") & " points. " &
			    "The most affordable city is " & TopCity & " with " & FORMAT(TopScore, "0.0") & " points. " &
			    "Housing affordability measures the ratio of median home prices to median household income, reflecting how accessible homeownership is. " &
			    IF(NOT ISBLANK(RankChange), 
			        "Year-over-year, " & CurrentCity & " " & RankDirection & " by " & ABS(RankChange) & " position" & IF(ABS(RankChange) = 1, "", "s") & " from rank #" & PrevRank & " in " & PrevYear & ". ",
			        "") &
			    "The ranking card shows the selected city's position, total cities count (" & TotalCities & "), and year-over-year change indicator. " &
			    "Lower scores and lower rank numbers indicate better housing affordability."
			
			RETURN
			AltText
			
