	measure 'Analysis - Trend Direction (Livability)' = ```
			
			VAR FirstYear = MIN('City Metrics'[Year])
			VAR LastYear = MAX('City Metrics'[Year])
			
			VAR FirstValue = 
			    CALCULATE(
			        [Avg Livability Score],
			        'City Metrics'[Year] = FirstYear
			    )
			    
			VAR LastValue = 
			    CALCULATE(
			        [Avg Livability Score],
			        'City Metrics'[Year] = LastYear
			    )
			
			VAR PctChange = DIVIDE(LastValue - FirstValue, FirstValue, 0)
			
			RETURN
			    SWITCH(
			        TRUE(),
			        PctChange >= 0.05, "improving",
			        PctChange <= -0.05, "declining",
			        "stable"
			    )
			```
		lineageTag: 35729770-87eb-4fd5-8f6d-04aa0f39d7d8

	measure 'Analysis - Trend Direction (Housing)' = ```
			
			VAR FirstYear = MIN('City Metrics'[Year])
			VAR LastYear = MAX('City Metrics'[Year])
			
			VAR FirstValue = 
			    CALCULATE(
			        [Avg Housing Affordability],
			        'City Metrics'[Year] = FirstYear
			    )
			    
			VAR LastValue = 
			    CALCULATE(
			        [Avg Housing Affordability],
			        'City Metrics'[Year] = LastYear
			    )
			
			VAR PctChange = DIVIDE(LastValue - FirstValue, FirstValue, 0)
			
			
			RETURN
			    SWITCH(
			        TRUE(),
			        PctChange <= -0.05, "improving",  
			        PctChange >= 0.05, "declining",   
			        "stable"
			    )
			```
		lineageTag: a45cc5f9-db8a-4ee0-a424-26c0195fb214

