	measure 'Page 2 - Card - Housing Affordability HTML' = ```
			
			VAR CurrentCity = SELECTEDVALUE('City Lookup'[City], "Global")
			VAR SelectedYear = SELECTEDVALUE('City Metrics'[Year])
			VAR HasYearFilter = NOT(ISBLANK(SelectedYear))
			
			
			VAR XMinYear = 2015
			VAR XMaxYear = 2024
			
			VAR SparklineTable = 
			    ADDCOLUMNS(
			        CALCULATETABLE(
			            FILTER(
			                ALL('City Metrics'[Year]),
			                'City Metrics'[Year] >= 2015 && 'City Metrics'[Year] <= 2024
			            )
			        ),
			        "@Year", 'City Metrics'[Year],
			        "@Value", CALCULATE([Avg Housing Affordability], 'City Lookup'[City] = CurrentCity),
			        "@X", 5 + INT(74 * DIVIDE('City Metrics'[Year] - XMinYear, XMaxYear - XMinYear))
			    )
			
			VAR YMinValue = MINX(SparklineTable, [@Value])
			VAR YMaxValue = MAXX(SparklineTable, [@Value])
			VAR YRange = YMaxValue - YMinValue
			VAR SafeRange = IF(YRange = 0, 1, YRange)
			
			VAR SparklineTableWithY = 
			    ADDCOLUMNS(
			        SparklineTable,
			        "@Y", 4 + INT(16 * DIVIDE([@Value] - YMinValue, SafeRange))
			    )
			
			    VAR LastX =
			    MAXX(
			        SparklineTableWithY,
			        [@X]
			    )
			
			    VAR MidYear = 2020
			VAR MidX =
			    5 + INT(
			        74 * DIVIDE(MidYear - XMinYear, XMaxYear - XMinYear)
			    )
			
			
			
			VAR Points = 
			    CONCATENATEX(
			        SparklineTableWithY,
			        [@X] & "," & (24 - [@Y]),
			        " ",
			        [@Year],
			        ASC
			    )
			
			VAR ValCurrent = IF(HasYearFilter, CALCULATE([Avg Housing Affordability], 'City Lookup'[City] = CurrentCity, 'City Metrics'[Year] = SelectedYear), BLANK())
			VAR ValPrev = IF(HasYearFilter, CALCULATE([Avg Housing Affordability], 'City Lookup'[City] = CurrentCity, 'City Metrics'[Year] = SelectedYear - 1), BLANK())
			VAR Diff = ValCurrent - ValPrev
			VAR BulletColor = IF(Diff <= 0, "#0066CC", "#C75B5B")
			
			VAR SelectedX = IF(HasYearFilter, 5 + INT(74 * DIVIDE(SelectedYear - XMinYear, XMaxYear - XMinYear)), BLANK())
			VAR SelectedY = IF(HasYearFilter, 24 - (4 + INT(16 * DIVIDE(ValCurrent - YMinValue, SafeRange))), BLANK())
			
			VAR DotMarker = 
			    IF(
			        HasYearFilter,
			        "<circle cx='" & SelectedX & "' cy='" & SelectedY & "' r='2.8' fill='" & BulletColor & "' stroke='white' stroke-width='1.5'>" &
			        "<animate attributeName='opacity' from='0' to='1' dur='0.5s' begin='1s' fill='freeze' />" &
			        "</circle>",
			        ""
			    )
			
			VAR GradID = "grad" & SUBSTITUTE(SUBSTITUTE(CurrentCity, " ", ""), "-", "")
			
			VAR SVG_Raw = 
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 84 28'>" & 
			"<defs>" &
			"<linearGradient id='" & GradID & "' x1='0' y1='0' x2='0' y2='24' gradientUnits='userSpaceOnUse'>" &
			"<stop stop-color='#0066CC' offset='0' />" &
			"<stop stop-color='transparent' offset='1' />" &
			"</linearGradient>" &
			"</defs>" &
			
			
			"<polyline fill='url(#" & GradID & ")' fill-opacity='0.18' " &
			"stroke='none' " &
			"points='0 24 " & Points & " " & LastX & " 24'>" &
			"<animate attributeName='fill-opacity' from='0' to='0.18' dur='0.5s' begin='1s' fill='freeze' />" &
			"</polyline>" &
			
			
			"<polyline fill='none' " &
			"stroke='#B8B8B8' stroke-width='0.9' stroke-linecap='round' stroke-linejoin='round' " &
			"points='" & Points & "' " &
			"stroke-dasharray='500' stroke-dashoffset='500'>" &
			"<animate attributeName='stroke-dashoffset' from='500' to='0' dur='1.2s' begin='0s' fill='freeze' />" &
			"</polyline>" &
			
			/* X AXIS LABELS */
			"<text x='5' y='28' font-family='Segoe UI, system-ui, sans-serif' font-size='4' fill='#9E9E9E' text-anchor='start'>2015</text>" &
			"<text x='" & MidX & "' y='28' font-family='Segoe UI, system-ui, sans-serif' font-size='4' fill='#B0B0B0' text-anchor='middle'>2020</text>" &
			"<text x='" & LastX & "' y='28' font-family='Segoe UI, system-ui, sans-serif' font-size='4' fill='#9E9E9E' text-anchor='end'>2024</text>"
			
			&
			
			DotMarker &
			"</svg>"
			
			
			VAR SVGSparkline = "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(SVG_Raw, "#", "%23"), "'", """")
			
			RETURN
			"<div style='font-family:system-ui,sans-serif;background:white;border-radius:10px;padding:12px 14px;position:relative;overflow:hidden;height:100%;cursor:pointer;'>" &
			  "<style>" &
			    ".card-content-housing { transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1); }" &
			    ".card-container-housing:hover .card-content-housing { transform: translateY(-100%); }" &
			    ".tooltip-overlay-housing { " &
			        "position: absolute; top: 100%; left: 0; width: 100%; height: 100%; " &
			        "background: #0066CC; color: white; padding: 14px; " &
			        "transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1); " &
			        "display: flex; flex-direction: column; justify-content: center; box-sizing: border-box;" &
			    "}" &
			    ".card-container-housing:hover .tooltip-overlay-housing { transform: translateY(-100%); }" &
			  "</style>" &
			
			  "<div class='card-container-housing' style='position:relative;width:100%;height:100%;overflow:hidden;'>" &
			    "<div class='card-content-housing' style='height:100%;display:flex;flex-direction:column;'>" &
			      "<div style='margin-bottom:6px'>" &
			        "<svg width='20' height='20' viewBox='0 0 24 24' fill='none' stroke='#999999' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>" &
			          "<path d='M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z'></path>" &
			          "<polyline points='9 22 9 12 15 12 15 22'></polyline>" &
			        "</svg>" &
			      "</div>" &
			      "<div style='font-size:25px;font-weight:700;color:#1a1a1a;line-height:1.1;margin-bottom:2px'>" &
			        FORMAT([Avg Housing Affordability], "0.0") &
			      "</div>" &
			      "<div style='font-size:11px;font-weight:500;color:#666666;margin-bottom:8px'>" &
			        "Avg Housing Affordability" &
			      "</div>" &
			      
			      "<div style='border-top:1px solid #f0f0f0; margin-bottom:10px;'>" &
			        "<img src='" & SVGSparkline & "' style='width:100%;height:auto;display:block;' />" &
			      "</div>" &
			    "</div>" &
			    
			    "<div class='tooltip-overlay-housing'>" &
			      "<div style='font-size:12px;font-weight:700;margin-bottom:6px;border-bottom:1px solid rgba(255,255,255,0.3);padding-bottom:4px;'>Quick Guide</div>" &
			      "<p style='font-size:10px;line-height:1.4;margin:0;font-weight:400;'>" &
			        "This index measures housing costs relative to income. <strong>Lower values indicate better affordability</strong>." &
			      "</p>" &
			    "</div>" &
			  "</div>" &
			"</div>"
			```
		lineageTag: bd99af77-1196-4cc0-b839-3629362a9b96

