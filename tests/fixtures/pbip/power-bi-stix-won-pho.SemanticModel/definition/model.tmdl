model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Year1","Year2"]

annotation PBI_ProTooling = ["CalcGroup","DaxCopilot_Change_Accepted_In_Desktop","DaxQueryView_Desktop","TMDLView_Desktop","MCP-PBIModeling","WebModelingEdit","DevMode"]

ref table Map
ref table Formatting
ref table Markdown
ref table 'Field parameter'
ref table 'Scatter symmetry'
ref table 'Gantt software project'
ref table 'Category parameter'
ref table Financials
ref table Calculations
ref table 'ClusterMappingTable 2'
ref table 'Time Calculation'
ref table Date
ref table 'Shape map for regions'
ref table 'Shape map for stores'

ref cultureInfo en-US

