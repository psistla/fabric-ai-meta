		sourceColumn: [Region]

		annotation SummarizationSetBy = Automatic

	column 'Sales amt' = RANDBETWEEN(10,1000)
		formatString: 0
		lineageTag: a20ad4d6-6e44-43d4-9472-5ab316696fa7
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition 'Shape map for regions' = calculated
		mode: import
