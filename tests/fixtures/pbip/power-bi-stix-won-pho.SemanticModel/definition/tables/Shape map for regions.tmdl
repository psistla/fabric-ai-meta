table 'Shape map for regions'
	lineageTag: c4fe54e8-8120-4307-833a-9d4eb0a0f9e6

	measure 'Total Sales' = sum('Shape map for regions'[Sales amt])
		formatString: 0
		lineageTag: 9f15b6af-9b1f-4502-bbdd-d305717b0dd0

	measure 'Region Gradient Color' =
			
			-- ============================================
			-- Toggle: TRUE  = scale within each region (each region's top state is fully saturated)
			--         FALSE = scale across all regions  (only the top state nationally is fully saturated)
			VAR ScaleWithinRegion = TRUE
			-- ============================================
			
			VAR CurrentSales = [Total Sales]
			
			VAR ScopeMin =
			    IF (
			        ScaleWithinRegion,
			        CALCULATE (
			            MINX ( VALUES ( 'Shape map for regions'[StateName] ), [Total Sales] ),
			            ALLEXCEPT ( 'Shape map for regions', 'Shape map for regions'[Region] )
			        ),
			        CALCULATE (
			            MINX ( VALUES ( 'Shape map for regions'[StateName] ), [Total Sales] ),
			            ALL ( 'Shape map for regions' )
			        )
			    )
			
			VAR ScopeMax =
			    IF (
			        ScaleWithinRegion,
			        CALCULATE (
			            MAXX ( VALUES ( 'Shape map for regions'[StateName] ), [Total Sales] ),
			            ALLEXCEPT ( 'Shape map for regions', 'Shape map for regions'[Region] )
			        ),
			        CALCULATE (
			            MAXX ( VALUES ( 'Shape map for regions'[StateName] ), [Total Sales] ),
			            ALL ( 'Shape map for regions' )
			        )
			    )
			
			-- Normalize current value to 0..1 within the chosen scope
			VAR Ratio =
			    DIVIDE ( CurrentSales - ScopeMin, ScopeMax - ScopeMin )
			
			VAR Region = SELECTEDVALUE ( 'Shape map for regions'[Region] )
			
			-- End color (full saturation) per region
			VAR EndR = SWITCH ( Region,
			    "Northwest", 17,  "Northeast", 216, "Southeast", 116,
			    "Southwest", 224, "Alaska", 17,     "Hawaii", 17,    128 )
			VAR EndG = SWITCH ( Region,
			    "Northwest", 141, "Northeast", 106, "Southeast", 78,
			    "Southwest", 68,  "Alaska", 141,    "Hawaii", 141,   128 )
			VAR EndB = SWITCH ( Region,
			    "Northwest", 255, "Northeast", 44,  "Southeast", 194,
			    "Southwest", 167, "Alaska", 255,    "Hawaii", 255,   128 )
			
			-- Start = light tint of end (0 = white, 1 = full color)
			VAR TintStrength = 0.15
			VAR StartR = 255 - ( 255 - EndR ) * TintStrength
			VAR StartG = 255 - ( 255 - EndG ) * TintStrength
			VAR StartB = 255 - ( 255 - EndB ) * TintStrength
			
			-- Clamp ratio to 0..1 (just in case)
			VAR R01 = MIN ( 1, MAX ( 0, Ratio ) )
			
			-- Interpolate
			VAR R = INT ( StartR + ( EndR - StartR ) * R01 )
			VAR G = INT ( StartG + ( EndG - StartG ) * R01 )
			VAR B = INT ( StartB + ( EndB - StartB ) * R01 )
			
			VAR HexChars = "0123456789ABCDEF"
			VAR Hex =
			    "#" &
			    MID ( HexChars, QUOTIENT ( R, 16 ) + 1, 1 ) & MID ( HexChars, MOD ( R, 16 ) + 1, 1 ) &
			    MID ( HexChars, QUOTIENT ( G, 16 ) + 1, 1 ) & MID ( HexChars, MOD ( G, 16 ) + 1, 1 ) &
			    MID ( HexChars, QUOTIENT ( B, 16 ) + 1, 1 ) & MID ( HexChars, MOD ( B, 16 ) + 1, 1 )
			
			RETURN
			    IF ( ISBLANK ( CurrentSales ), "#FFFFFF", Hex )
		lineageTag: 6a1de7fa-992b-463f-9edd-e2de7a35a114

	column Postal
		lineageTag: 516d0018-7fd0-4de6-a689-786190d495db
