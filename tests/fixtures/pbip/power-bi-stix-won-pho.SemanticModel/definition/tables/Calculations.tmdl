	measure 'Discounts YoY %' =
			// Apply YoY % calculation group item to Discounts
			CALCULATE([Discounts], 'Time Calculation'[Time Calculation] = "YoY %")
		formatString: #,0%;-#,0%;#,0%
		lineageTag: 1daef4f6-1e3f-4371-ab09-33d3beb51708

	/// Change in profit compared to the same period last year. At totals, only compares months that exist in both years.
	measure 'Profit YoY' =
