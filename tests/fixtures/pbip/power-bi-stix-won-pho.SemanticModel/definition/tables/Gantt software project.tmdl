/// Hidden sample dataset of software-project tasks (start, end, progress, dependencies) for Gantt visual demos.
table 'Gantt software project'
	isHidden
	lineageTag: 50f1c844-a369-4e7e-a408-28a79f5009d9

	/// Marker measure used for the Gantt chart demo.
	measure FabCon = date(2025,3,15)
		formatString: General Date
		isHidden
		lineageTag: 3a89afd2-6bda-4050-9121-b4d1f0faa116

	column 'Task ID'
		isHidden
		formatString: 0
		lineageTag: ac26e8a5-1758-48c1-9a62-3b6c2d84c5f1
		summarizeBy: count
		isNameInferred
		sourceColumn: [Task ID]

		annotation SummarizationSetBy = Automatic

	column Task
		isHidden
		lineageTag: 69da837b-dcc4-4013-8782-b1a9e961afcd
		summarizeBy: none
		isNameInferred
		sourceColumn: [Task]

		annotation SummarizationSetBy = Automatic

	column Category
		isHidden
		lineageTag: ad5ce376-583f-4a13-987c-c0bb92fabaca
		summarizeBy: none
		isNameInferred
		sourceColumn: [Category]

		annotation SummarizationSetBy = Automatic

	column Start
		isHidden
		formatString: General Date
		lineageTag: 17345aab-d1fe-4e4e-bf8a-3390e1fc6443
		summarizeBy: none
		isNameInferred
