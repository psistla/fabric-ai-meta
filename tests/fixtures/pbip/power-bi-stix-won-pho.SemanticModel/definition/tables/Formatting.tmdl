/// Measure table for measures used in conditional formatting, titles, colors, and icons.
table Formatting
	lineageTag: d66db350-8ec9-47df-85d5-4e0cf7dfda08

	/// Constant value 1, used as the upper bound for percentage-style data bars and gauges.
	measure 100% = 1
		formatString: 0
		displayFolder: Values
		lineageTag: 5fbf58fa-f941-4920-b854-4a84320ee699

	/// Constant value 0.75, used as a target/threshold for conditional formatting.
	measure 75% = 0.75
		displayFolder: Values
		lineageTag: 2c420bdb-b90a-4973-b6b5-96df1146e530

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Dynamic title showing the segment with the highest total sales in the current filter context.
	measure 'Title Total Sales Top Segment' =
			VAR _Summary =
			            SUMMARIZECOLUMNS(
			                'Financials'[Segment],
			                "Total Sales", [Sales]
			            )
			        VAR _TopSegment =
			            TOPN(
			                1,
			                _Summary,
			                [Total Sales],
			                DESC
			            )
			        VAR _SegmentName =
			            MAXX(
			                _TopSegment,
			                'Financials'[Segment]
			            )
			        VAR _TopSales =
			            MAXX(
			                _TopSegment,
			                [Total Sales]
			            )
			        // Total sales in the current filter context (all segments combined)
			        VAR _TotalSales =
			            [Sales]
			        RETURN
			            IF(
			                ISBLANK(_SegmentName),
			                // Fallback when no segment is available
			                "Total sales is "
			                    & FORMAT(_TotalSales, "$#,0"),
			                // Main pattern: "[segment] ($#) is the top segment and total sales is $#"
			                _SegmentName
			                    & " ("
			                    & FORMAT(_TopSales, "$#,0")
			                    & ") is the top segment and total sales is "
			                    & FORMAT(_TotalSales, "$#,0")
			            )
		displayFolder: Titles
		lineageTag: 504123ea-9cd3-4d3d-8b77-88d06cfae4fa

	/// Variant of the top-segment title used directly as a DAX measure title.
	measure 'Title Total Sales Top Segment (DAX measure)' =
			"VAR _Summary ="
			        & UNICHAR(10) & "    SUMMARIZECOLUMNS("
			        & UNICHAR(10) & "        'Financials'[Segment],"
			        & UNICHAR(10) & "        ""Total Sales"", [Total Sales]"
			        & UNICHAR(10) & "    )"
			        & UNICHAR(10) & "VAR _TopSegment ="
			        & UNICHAR(10) & "    TOPN("
			        & UNICHAR(10) & "        1,"
			        & UNICHAR(10) & "        _Summary,"
			        & UNICHAR(10) & "        [Total Sales],"
			        & UNICHAR(10) & "        DESC"
			        & UNICHAR(10) & "    )"
			        & UNICHAR(10) & "VAR _SegmentName ="
			        & UNICHAR(10) & "    MAXX("
			        & UNICHAR(10) & "        _TopSegment,"
			        & UNICHAR(10) & "        'Financials'[Segment]"
			        & UNICHAR(10) & "    )"
			        & UNICHAR(10) & "VAR _TopSales ="
			        & UNICHAR(10) & "    MAXX("
			        & UNICHAR(10) & "        _TopSegment,"
			        & UNICHAR(10) & "        [Total Sales]"
			        & UNICHAR(10) & "    )"
			        & UNICHAR(10) & "VAR _TotalSales ="
			        & UNICHAR(10) & "    [Total Sales]"
			        & UNICHAR(10) & "RETURN"
			        & UNICHAR(10) & "    IF("
			        & UNICHAR(10) & "        ISBLANK(_SegmentName),"
			        & UNICHAR(10) & "        ""Total sales is """
			        & UNICHAR(10) & "            & FORMAT(_TotalSales, ""$#,0""),"
			        & UNICHAR(10) & "        _SegmentName"
			        & UNICHAR(10) & "            & "" ("""
			        & UNICHAR(10) & "            & FORMAT(_TopSales, ""$#,0"")"
			        & UNICHAR(10) & "            & "") is the top segment and total sales is """
			        & UNICHAR(10) & "            & FORMAT(_TotalSales, ""$#,0"")"
			        & UNICHAR(10) & "    )"
		displayFolder: Titles
		lineageTag: a355fcfc-7c5d-4d3b-8a8f-2f97a712ba43

	/// Helper text/link measure pointing users to docs on table conditional formatting.
	measure 'Learn more about table conditional formatting' = "https://learn.microsoft.com/power-bi/create-reports/desktop-conditional-table-formatting"
		displayFolder: Titles
		lineageTag: 447fb25e-7904-4c29-8570-013733dd0864
		dataCategory: WebUrl

	/// Hex color code returned per Discount Band, used to color visuals consistently.
	measure 'Discount Band Color' =
			VAR _Band = SELECTEDVALUE('Financials'[Discount Band])
			        RETURN
			            SWITCH(
			                TRUE(),
			                _Band = "High",   "#F8696B", // red
			                _Band = "Medium", "#FFEB84", // yellow
			                _Band = "Low",    "#63BE7B", // green
			                _Band = "None",   "#D9D9D9", // grey
			                BLANK()
			            )
		displayFolder: Colors
		lineageTag: c32ca556-6d89-4eda-bd0b-6f87c6cf8d07

	/// DAX-measure variant of Discount Band Color used in conditional formatting rules.
	measure 'Discount Band Color (DAX measure)' =
			"VAR _Band = SELECTEDVALUE('Financials'[Discount Band])"
			        & UNICHAR(10) & "RETURN"
			        & UNICHAR(10) & "    SWITCH("
			        & UNICHAR(10) & "        TRUE(),"
			        & UNICHAR(10) & "        _Band = ""High"",   ""#F8696B"",    // red"
			        & UNICHAR(10) & "        _Band = ""Medium"", ""#FFEB84"",    // yellow"
			        & UNICHAR(10) & "        _Band = ""Low"",    ""#63BE7B"",    // green"
			        & UNICHAR(10) & "        _Band = ""None"",   ""#D9D9D9"",    // grey"
			        & UNICHAR(10) & "        BLANK()"
			        & UNICHAR(10) & "    )"
		displayFolder: Colors
		lineageTag: 4e09a0ae-c66e-4cfa-94e4-0442f86dfa9d

	/// Dynamic title displaying total sales for the current filter context.
	measure 'Title total sales' = "Total sales: " & FORMAT([Sales], "$#,##0")
		displayFolder: Titles
		lineageTag: 36ffce8b-caf0-4798-8b50-f88627ae80a8

